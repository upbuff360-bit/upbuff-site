  @media (min-width: 1024px) { .ia-stage { margin: 32px 32px 32px 0; padding: 56px 48px 0; height: 520px; } }
  .ia-chat { width: 100%; max-width: 520px; height: 100%; background: #fff; border-radius: 22px 22px 0 0; padding: 28px 24px; display: flex; flex-direction: column; gap: 22px; font-size: 15px; color: #1f2937; }
