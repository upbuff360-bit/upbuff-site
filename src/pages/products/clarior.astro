<script>
  let countdownTimer: ReturnType<typeof setInterval> | undefined;
  function initCountdown() {
    clearInterval(countdownTimer);
    const box = document.querySelector<HTMLElement>('[data-cl-countdown]');
    if (!box) return;
    const target = Number(box.dataset.clCountdown);
    const startedBefore = target > Date.now(); // avoids a reload loop if clocks differ
    const set = (k: string, v: number) => {
      const el = box.querySelector<HTMLElement>(`[data-cl-unit="${k}"]`);
      if (el) el.textContent = String(v).padStart(2, '0');
    };
    const tick = () => {
      const left = Math.max(0, target - Date.now());
      const s = Math.floor(left / 1000);
      set('days', Math.floor(s / 86400));
      set('hours', Math.floor((s % 86400) / 3600));
      set('minutes', Math.floor((s % 3600) / 60));
      set('seconds', s % 60);
      // At unveiling time, reload once: the server then serves the full page.
      if (left === 0 && startedBefore) { clearInterval(countdownTimer); setTimeout(() => location.reload(), 1500); }
    };
    tick();
    countdownTimer = setInterval(tick, 1000);
  }

  // Draw the yellow ribbon when the board scrolls into view.
  function initRibbon() {
    const board = document.querySelector<HTMLElement>('.cl-board');
    if (!board || !('IntersectionObserver' in window)) return;
    board.classList.add('cl-draw');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { board.classList.add('is-drawn'); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(board);
  }

  function initClariorVideo() {
    const overlay = document.getElementById('clarior-video-overlay');
    const backdrop = document.getElementById('clarior-video-backdrop');
    const closeButton = document.getElementById('clarior-video-close');
    const iframe = document.getElementById('clarior-video-iframe');
    const videoLink = document.querySelector<HTMLAnchorElement>('[href="#clarior-video"]');
    if (!overlay || !backdrop || !closeButton || !iframe || !videoLink) return;

    const closeVideo = () => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.inert = true;
      iframe.removeAttribute('src');
      document.body.style.overflow = '';
      videoLink.focus();
    };

    videoLink.addEventListener('click', (event) => {
      event.preventDefault();
      iframe.setAttribute('src', 'https://www.youtube.com/embed/qahCMMyeGzw?autoplay=1&rel=0&modestbranding=1');
      overlay.inert = false;
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
      closeButton.focus();
    });
    closeButton.addEventListener('click', closeVideo);
    backdrop.addEventListener('click', closeVideo);
  }

  function initClarior() {
    initCountdown();
    initRibbon();
    initClariorVideo();
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.getElementById('clarior-video-overlay')?.getAttribute('aria-hidden') === 'false') {
      document.getElementById('clarior-video-close')?.click();
    }
  });
  document.addEventListener('astro:page-load', initClarior);
</script>

<script>
  // Privacy demo: shows the chat result, flips to "what the AI sees / what stays with you",
  // flips back and repeats while the demo is on screen.
  function initPrivacyDemo() {
    document.querySelectorAll<HTMLElement>('[data-pv-demo]').forEach(bindPrivacyDemo);
  }
  function bindPrivacyDemo(demo: HTMLElement) {
    if (demo.dataset.pvBound) return;
    demo.dataset.pvBound = '1';
    // Each demo has its own timing (data-pv-flip / data-pv-cycle, in ms) so they don't flip together.
    const FLIP_AT = Number(demo.dataset.pvFlip) || 5500;
    const CYCLE = Math.max(Number(demo.dataset.pvCycle) || 15000, FLIP_AT + 4000);

    // One pending step at a time, so it can be paused on hover and resumed with the time left.
    let timer: ReturnType<typeof setTimeout> | undefined;
    let action: (() => void) | undefined;
    let dueAt = 0;
    let remaining = 0;
    let visible = false;
    let hovered = false;

    const schedule = (fn: () => void, ms: number) => {
      clearTimeout(timer);
      action = fn; dueAt = Date.now() + ms; remaining = ms;
      if (visible && !hovered) timer = setTimeout(fn, ms);
    };
    const flip = () => { demo.classList.add('is-flipped'); schedule(cycle, CYCLE - FLIP_AT); };
    function cycle() {
      demo.classList.remove('is-play', 'is-flipped');
      void demo.offsetWidth;
      demo.classList.add('is-play');
      schedule(flip, FLIP_AT);
    }
    const pause = () => {
      if (timer === undefined) return;
      clearTimeout(timer); timer = undefined;
      remaining = Math.max(0, dueAt - Date.now());
    };
    const resume = () => {
      if (!visible || hovered || !action) return;
      dueAt = Date.now() + remaining;
      timer = setTimeout(action, remaining);
    };

    demo.addEventListener('mouseenter', () => { hovered = true; demo.classList.add('is-paused'); pause(); });
    demo.addEventListener('mouseleave', () => { hovered = false; demo.classList.remove('is-paused'); resume(); });

    if (!('IntersectionObserver' in window)) { visible = true; cycle(); return; }
    new IntersectionObserver((entries) => {
      const now = entries.some((e) => e.isIntersecting);
      if (now === visible) return;
      visible = now;
      clearTimeout(timer); timer = undefined;
      if (visible) cycle();
    }, { threshold: 0.35 }).observe(demo);
  }
  document.addEventListener('astro:page-load', initPrivacyDemo);
</script>

<script>
  // Huddle Global background: green particles rising along a curved stream (canvas, no libraries).
  // Used by the Huddle Global card and the "Explore Clarior in action" card.
  function initHuddleStream() {
    document.querySelectorAll<HTMLCanvasElement>('[data-hg-canvas]').forEach(bindStream);
  }
  function bindStream(canvas: HTMLCanvasElement) {
    if (canvas.dataset.hgBound) return;
    canvas.dataset.hgBound = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type P = { t: number; off: number; r: number; a: number; l: number; sp: number; wob: number; ph: number; stray: boolean; sx: number; sy: number };
    let W = 0, H = 0, parts: P[] = [], raf = 0, running = false;

    // Stream path: in from the bottom-left, along the bottom, then up the right side.
    const P0 = [-0.05, 1.08], P1 = [0.55, 0.7], P2 = [1.02, 1.05], P3 = [0.9, -0.08];
    const bez = (t: number) => {
      const u = 1 - t;
      const x = u*u*u*P0[0] + 3*u*u*t*P1[0] + 3*u*t*t*P2[0] + t*t*t*P3[0];
      const y = u*u*u*P0[1] + 3*u*u*t*P1[1] + 3*u*t*t*P2[1] + t*t*t*P3[1];
      const dx = 3*u*u*(P1[0]-P0[0]) + 6*u*t*(P2[0]-P1[0]) + 3*t*t*(P3[0]-P2[0]);
      const dy = 3*u*u*(P1[1]-P0[1]) + 6*u*t*(P2[1]-P1[1]) + 3*t*t*(P3[1]-P2[1]);
      return [x, y, dx, dy];
    };
    const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;

    const make = (): P => ({
      t: Math.random(), off: gauss(), r: Math.random() < 0.8 ? 0.5 + Math.random() * 1.3 : 1.8 + Math.random() * 1.8,
      a: 0.45 + Math.random() * 0.55, l: 48 + Math.random() * 22, sp: 0.00025 + Math.random() * 0.0006,
      wob: 2 + Math.random() * 6, ph: Math.random() * Math.PI * 2, stray: Math.random() < 0.06,
      sx: Math.random(), sy: Math.random(),
    });

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(6000, Math.max(1500, W * H / 120)));
      parts = Array.from({ length: n }, make);
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, W, H);
      const minSide = Math.min(W, H);
      for (const p of parts) {
        let x: number, y: number;
        if (p.stray) {
          p.sy -= p.sp * 0.6; if (p.sy < -0.02) { p.sy = 1.02; p.sx = Math.random(); }
          x = p.sx * W; y = p.sy * H;
        } else {
          p.t += p.sp; if (p.t > 1) { p.t = 0; p.off = gauss(); }
          const [bx, by, dx, dy] = bez(p.t);
          const len = Math.hypot(dx * W, dy * H) || 1;
          const nx = -dy * H / len, ny = dx * W / len;               // normal to the stream
          const width = minSide * (0.13 + 0.13 * Math.sin(p.t * Math.PI)); // wider in the middle
          const w = Math.sin(time / 1400 + p.ph) * p.wob;
          x = bx * W + nx * (p.off * width + w);
          y = by * H + ny * (p.off * width + w) - Math.cos(time / 1700 + p.ph) * p.wob;
        }
        const edge = Math.max(0, 1 - Math.abs(p.off) * 0.9);
        ctx.globalAlpha = p.stray ? p.a * 0.4 : p.a * (0.45 + 0.55 * edge);
        ctx.fillStyle = `hsl(150, 62%, ${p.l}%)`;
        ctx.beginPath(); ctx.arc(x, y, p.r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (time: number) => { draw(time); raf = requestAnimationFrame(loop); };
    const start = () => { if (running || reduce) return; running = true; raf = requestAnimationFrame(loop); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize(); draw(0);
    let rt: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { resize(); draw(performance.now()); }, 150); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((e) => (e.some((x) => x.isIntersecting) ? start() : stop())).observe(canvas);
    } else start();
  }
  document.addEventListener('astro:page-load', initHuddleStream);
</script>

<script>
  // Clarior in action: tabs play automatically; clicking a tab stops autoplay.
  // Panels slide left/right when switching, and the chat replays on each panel.
  function initInAction() {
    const root = document.querySelector<HTMLElement>('#clarior-in-action');
    if (!root || root.dataset.iaBound) return;
    root.dataset.iaBound = '1';
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ia-tab]'));
    const panelOf = (t: HTMLButtonElement) => root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'))!;
    const INTERVAL = 6000;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let autoplay = true;
    let visible = false;

    const show = (next: number, focus = false) => {
      if (next === current) return;
      const dir = next > current ? 1 : -1;
      const oldP = panelOf(tabs[current]);
      const newP = panelOf(tabs[next]);
      // Put the incoming panel on the side it enters from, without animating that move.
      newP.classList.add('ia-notr');
      newP.style.setProperty('--ia-off', `${dir * 100}%`);
      void newP.offsetWidth;
      newP.classList.remove('ia-notr');
      oldP.style.setProperty('--ia-off', `${-dir * 100}%`);
      oldP.classList.remove('is-active', 'is-live'); oldP.inert = true;
      newP.classList.add('is-active'); newP.inert = false;
      void newP.offsetWidth; newP.classList.add('is-live');
      tabs.forEach((t, i) => { t.setAttribute('aria-selected', String(i === next)); t.tabIndex = i === next ? 0 : -1; });
      const bar = tabs[next].parentElement!;
      bar.scrollTo({ left: tabs[next].offsetLeft - bar.clientWidth / 2 + tabs[next].offsetWidth / 2, behavior: 'smooth' });
      if (focus) tabs[next].focus();
      current = next;
    };
    const stopAuto = () => { autoplay = false; clearInterval(timer); };
    const runAuto = () => {
      clearInterval(timer);
      if (autoplay && visible) timer = setInterval(() => show((current + 1) % tabs.length), INTERVAL);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stopAuto(); show(i); });
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
        e.preventDefault(); stopAuto();
        show((i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });

    const first = panelOf(tabs[0]);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((e) => {
        visible = e.some((x) => x.isIntersecting);
        if (visible) first.classList.add('is-live');
        runAuto();
      }, { threshold: 0.3 }).observe(root.querySelector('[data-ia]')!);
    } else { visible = true; first.classList.add('is-live'); runAuto(); }
  }
  document.addEventListener('astro:page-load', initInAction);
</script>
