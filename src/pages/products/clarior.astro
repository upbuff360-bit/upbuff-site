---
/**
 * Clarior — Conversational AI for SAP Business One.
 * One permanent URL: upbuff.com/products/clarior
 *
 *   Phase A (prelaunch teaser)   until LAUNCH_AT
 *   Phase B (full product page)  from LAUNCH_AT onward
 *
 * The page is server-rendered on every request (prerender = false), so it
 * switches from Phase A to Phase B by itself at LAUNCH_AT — no redeploy and
 * no URL change, so every social post, QR code and invitation stays valid.
 *
 * Preview Phase B before launch (local dev only):  /products/clarior?phase=b
 */
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import HeroOrbital from '~/components/widgets/HeroOrbital.astro';
import HeroChatConsole from '~/components/widgets/HeroChatConsole.astro';
import ParticleGlobe from '~/components/widgets/ParticleGlobe.astro';
import CtaBanner from '~/components/widgets/CtaBanner.astro';
import ContentSplitCard from '~/components/widgets/ContentSplitCard.astro';
import FaqAccordion from '~/components/widgets/FaqAccordion.astro';
import FeaturesGrid from '~/components/widgets/FeaturesGrid.astro';
import ProblemSplit from '~/components/widgets/ProblemSplit.astro';
import FeaturesHighlights from '~/components/widgets/FeaturesHighlights.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

// Global unveiling: November 8, 2026 · 6:00 PM IST
const LAUNCH_AT = new Date('2026-11-08T18:00:00+05:30');

const previewB = import.meta.env.DEV && Astro.url.searchParams.get('phase') === 'b';
const phase: 'A' | 'B' = previewB || Date.now() >= LAUNCH_AT.getTime() ? 'B' : 'A';

const pageUrl = 'https://www.upbuff.com/products/clarior';

const metaTitle =
  phase === 'A'
    ? 'Clarior — Unveiling November 8, 2026'
    : 'Clarior: SAP Business One AI Integration & Chatbot';
const metaDescription =
  phase === 'A'
    ? 'What if your ERP could answer you? Clarior, an innovation from UpBuff Technologies, is unveiled on November 8, 2026 at 6:00 PM IST. Designed for businesses using SAP Business One.'
    : 'Clarior is the ERP AI chatbot for SAP Business One. Ask questions in plain language and get answers as tables, charts and dashboards, with read-only queries.';

const metadata = {
  title: metaTitle,
  description: metaDescription,
  canonical: pageUrl,
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
    url: pageUrl,
    title: metaTitle,
    description: metaDescription,
  },
  twitter: {
    cardType: 'summary_large_image',
    title: metaTitle,
    description: metaDescription,
  },
};

// ── Phase B content ───────────────────────────────────────────────
const steps = [
  { title: 'Ask naturally', description: 'Type your business question in everyday language.' },
  {
    title: 'Clarior interprets it',
    description:
      'Clarior uses AI to interpret your request and prepare an authorized, read-only database query.',
  },
  {
    title: 'Explore the results',
    description:
      'View the answer as a table or chart, ask follow-up questions, and save useful insights to dashboards.',
  },
];

// ── FAQ: one source for the visible accordion and the FAQPage schema ──
const faqs = [
  {
    question: 'What is Clarior?',
    answer:
      'Clarior is conversational AI for SAP Business One, an innovation from UpBuff Technologies. It lets you access your ERP information by asking business questions in natural language, instead of searching through multiple reports or navigating complicated filters.',
  },
  {
    question: 'Which ERP does Clarior work with?',
    answer: 'Clarior is designed for businesses using SAP Business One.',
  },
  {
    question: 'What kind of questions can I ask Clarior?',
    answer:
      'Everyday business questions such as “Who are my top 10 customers this year?”, “Which customers have overdue payments?”, “Which products haven’t moved in the last 90 days?”, “How did our sales perform last month?” and “Which products generate the highest margins?”.',
  },
  {
    question: 'How does Clarior turn a question into an answer?',
    answer:
      'You type your business question in everyday language. Clarior uses AI to interpret your request and prepare an authorized, read-only database query. You then view the answer as a table or chart, ask follow-up questions, and save useful insights to dashboards.',
  },
  {
    question: 'Can Clarior change data in SAP Business One?',
    answer: 'No. Database queries are read-only.',
  },
  {
    question: 'Is my transactional data sent to the cloud?',
    answer:
      'Transactional query results remain within the customer’s environment rather than being sent to the cloud AI service. Question text, conversation context, authorized schema information, and certain metadata are processed through the cloud services needed to operate Clarior.',
  },
  {
    question: 'How does Clarior’s SAP Business One AI integration work?',
    answer:
      'Clarior connects to SAP Business One through a customer-hosted gateway. Access is governed by configured permissions.',
  },
  {
    question: 'What is the Clarior Founding Customer Program?',
    answer:
      'We’re inviting qualifying SAP Business One customers to join the Clarior Founding Customer Program. It offers a structured evaluation, guided onboarding, and introductory commercial opportunities. Book a demo to apply.',
  },
  {
    question: 'Where can I see Clarior in action?',
    answer:
      'Book a live demonstration with our team, or visit the UpBuff Technologies exhibitor pod at Huddle Global (November 12–14, 2026, Kerala, India) and take the Clarior Live Challenge.',
  },
];

// ── Security card visuals: same markup as the "Three pillars" cards on erp-integrated-crm ──
const securityVisual = (src: string, alt: string, caption: string, sub: string, subColor: string) =>
  `<div class="flex flex-col items-center justify-center gap-2"><img src="${src}" alt="${alt}" class="max-h-[180px] w-auto object-contain"/><p class="text-sm font-semibold text-gray-800 text-center">${caption}</p><p class="text-xs ${subColor} text-center">${sub}</p></div>`;

// Same button style as the homepage hero's "Schedule a Demo" button (HeroOrbital primary).
const BTN = 'inline-flex items-center gap-2 px-6 py-2.5 rounded-full btn-primary hover:bg-blue-700 text-white font-semibold text-sm transition-colors duration-150';
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <meta name="author" content="UpBuff Technologies" />
    <meta property="og:site_name" content="UpBuff Technologies" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": metaTitle,
      "url": pageUrl,
      "description": metaDescription,
      "publisher": { "@type": "Organization", "name": "UpBuff Technologies", "url": "https://www.upbuff.com" },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.upbuff.com/" },
        { "@type": "ListItem", "position": 2, "name": "Clarior", "item": pageUrl },
      ],
    })} />
    {phase === 'B' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Clarior",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": pageUrl,
        "description": "Conversational AI for SAP Business One. Clarior helps you access ERP information through natural-language questions and transforms authorized ERP information into tables, charts, and dashboards.",
        "publisher": { "@type": "Organization", "name": "UpBuff Technologies", "url": "https://www.upbuff.com" },
        "offers": { "@type": "Offer", "price": "Contact for pricing", "priceCurrency": "USD" },
      })} />
    )}
    {phase === 'B' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({
          "@type": "Question",
          "name": f.question,
          "acceptedAnswer": { "@type": "Answer", "text": f.answer },
        })),
      })} />
    )}
  </Fragment>

  <Fragment slot="announcement" />

  {phase === 'A' ? (
    <>
      <!-- ══════════ PHASE A · 1. TEASER HERO + COUNTDOWN ══════════ -->
      <HeroOrbital
        tagline="An innovation from UpBuff Technologies"
        title="What if your ERP could answer you?"
        subtitle="Your ERP already holds the information. A simpler way to find the answers is coming."
      >
        <Fragment slot="background">
          <ParticleGlobe />
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px]"
            style="background:radial-gradient(ellipse at 50% 0%,rgba(99,102,241,0.15) 0%,transparent 70%);"
          />
        </Fragment>
        <Fragment slot="visual">
          <div class="w-full max-w-md rounded-2xl bg-white p-7 md:p-8 text-center shadow-2xl" data-cl-countdown={String(LAUNCH_AT.getTime())}>
            <p class="text-3xl md:text-4xl font-bold tracking-wide text-gray-900 font-heading">Nov 08, 2026</p>
            <p class="mt-2 text-gray-600">Global unveiling · 6:00 PM IST</p>
            <div class="mt-7 grid grid-cols-4 gap-2 sm:gap-3">
              {[['days', 'Days'], ['hours', 'Hours'], ['minutes', 'Minutes'], ['seconds', 'Seconds']].map(([k, label]) => (
                <div class="rounded-xl bg-gray-100 border border-gray-200 py-3 sm:py-4">
                  <span class="block text-2xl sm:text-4xl font-bold text-gray-900 tabular-nums" data-cl-unit={k}>--</span>
                  <span class="block mt-1 text-[10px] sm:text-xs uppercase tracking-wider text-gray-500">{label}</span>
                </div>
              ))}
            </div>
            <a href="/request-demo" class={BTN + ' mt-7 w-full justify-center'}>Request a Demo</a>
          </div>
        </Fragment>
      </HeroOrbital>

    </>
  ) : (
    <>
      <!-- ══════════ PHASE B · 1. HERO ══════════ -->
      <HeroOrbital
        tagline="Clarior"
        title="I'm Clarior. Stop Searching. Start Asking."
        subtitle={'<strong class="block text-lg text-white mb-3">The ERP AI chatbot for SAP Business One</strong>Your ERP contains valuable business information. With its SAP Business One AI integration, Clarior helps you access it through natural-language questions, without searching through multiple reports or navigating complicated filters.<strong class="block text-white mt-4">Ask a question. Explore your data. Discover the answers.</strong>'}
        actions={[
          { text: 'Book a Live Demo', href: '/request-demo', variant: 'primary' },
          { text: 'Watch Product Launch', href: '#clarior-video', variant: 'secondary' },
        ]}
      >
        <Fragment slot="background">
          <ParticleGlobe />
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px]"
            style="background:radial-gradient(ellipse at 50% 0%,rgba(99,102,241,0.15) 0%,transparent 70%);"
          />
        </Fragment>
        <Fragment slot="visual">
          <div class="w-full max-w-xl">
            <HeroChatConsole inputDemo title="Clarior" genAiIcon />
          </div>
        </Fragment>
      </HeroOrbital>

      <!-- ══════════ PHASE B · 1b. INDUSTRY PROBLEM (same ProblemSplit block as erp-integrated-crm) ══════════ -->
      <ProblemSplit
        id="problem"
        tagline="The Problem"
        title="Business decisions move faster than ERP reports"
        subtitle="Distributors, manufacturers and retailers running SAP Business One make daily decisions on stock, credit, pricing and margins. But getting a clear answer out of the ERP still takes reports, exports and specialist help — so decisions wait, or get made on yesterday’s numbers."
        items={[
          {
            title: 'Decisions on old numbers',
            description: 'By the time a report is run, exported and shared, stock, receivables and sales have already moved on.',
          },
          {
            title: 'A growing report backlog',
            description: 'Every new business question becomes a request to IT or a consultant, and the queue for custom reports keeps getting longer.',
          },
          {
            title: 'Numbers that don’t match',
            description: 'Each team pulls its own export and builds its own spreadsheet, so sales, finance and operations arrive with figures that don’t match.',
          },
          {
            title: 'Only experts get answers',
            description: 'Only users trained on SAP Business One screens and reports can get answers, so owners and managers wait on them for every question.',
          },
        ]}
      />

      <!-- ══════════ PHASE B · 2. THE PROBLEM (same FeaturesGrid block as asset-tracking-system) ══════════ -->
      <FeaturesGrid
        id="your-erp"
        tagline="Why Clarior"
        title="Your ERP has the data. Now get the answers."
        subtitle="Your sales, finance, purchasing, and inventory information is already available in SAP Business One."
        items={[
          { icon: 'tabler:report-search', title: 'Searching reports', description: 'The figure you need is often spread across several standard reports, and you first have to know which one to open.' },
          { icon: 'tabler:filter', title: 'Applying filters', description: 'Getting the right view means choosing date ranges, customers, items and warehouses — and getting every selection right.' },
          { icon: 'tabler:file-spreadsheet', title: 'Exporting to Excel', description: 'Many answers only appear after exporting data and reworking it in a spreadsheet — time spent, and a copy that soon goes out of date.' },
          { icon: 'tabler:users', title: 'Depending on someone else', description: 'When no report fits the question, you wait for a colleague or consultant to build one — and the decision waits with you.' },
          { icon: 'tabler:sparkles', title: 'Clarior introduces a more natural way.', description: 'Type your business question in everyday language. Clarior interprets it and prepares an authorized, read-only database query.' },
          { icon: 'tabler:message-question', title: 'Simply ask what you want to know.', description: 'View the answer as a table or chart, ask follow-up questions, and save useful insights to dashboards.' },
        ]}
      />

    </>
  )}

  <!-- Phase A: right after the hero. Phase B: replaces the plain "What can you ask Clarior?" grid. -->
      <!-- ══════════ BOTH PHASES · QUESTION BOARD — headline, ribbon, and example questions ══════════ -->
      <section id="questions" class="cl-board relative not-prose overflow-hidden bg-white dark:bg-slate-900 scroll-mt-[72px]">
        <!-- Light gray ribbon (decorative) -->
        <svg class="cl-ribbon absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path
            pathLength="1"
            d="M -80 170 C 260 150 520 260 520 520 C 520 760 230 820 190 660 C 150 500 420 430 720 440 C 1000 450 1110 560 1180 650 C 1260 750 1200 900 1080 1060 M 1080 1060 C 1000 900 1040 700 1180 600 C 1290 520 1400 520 1540 600"
            fill="none"
            stroke="#E5E7EB"
            stroke-width="64"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 md:pt-24 pb-16 lg:pb-0">
          {phase === 'A' && (
          <div class="relative z-10 text-center max-w-2xl mx-auto">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-[1.05] tracking-tight font-heading text-gray-950 dark:text-white">
              {phase === 'A' ? 'What if getting the answer was as easy as asking the question?' : 'What can you ask Clarior?'}
            </h2>
            <p class="mt-6 text-lg text-gray-600 dark:text-gray-300">
              {phase === 'A'
                ? 'Designed for businesses using SAP Business One.'
                : 'Clarior helps transform authorized ERP information into tables, charts, and dashboards.'}
            </p>
          </div>
          )}

          <!-- Clarior overview card with example questions around it -->
          <div class="cl-cards relative z-10 mt-10 lg:mt-12">
            <div class="cl-feature-card scroll-mt-[96px]">
              <div class="relative rounded-3xl bg-white border border-gray-200 cl-shadow-card px-6 py-10 md:px-10 md:py-14 text-center">
                <h2 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight font-heading text-gray-900">What can you ask Clarior?</h2>
                <p class="mt-4 text-lg text-gray-600 leading-relaxed">Clarior helps transform authorized ERP information into tables, charts, and dashboards.</p>
                <div class="pt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-3">
                  <span class="text-base font-semibold text-gray-900">Want to try it?</span>
                  <a href="/request-demo" class={BTN}>Request a Demo</a>
                </div>
              </div>
            </div>

            {[
              { q: 'Who owes us money?', tag: 'Finance', x: '0%', y: '2%', r: '-6deg' },
              { q: 'What’s moving slowly?', tag: 'Inventory', x: '12%', y: '34%', r: '9deg' },
              { q: 'Where are we losing margin?', tag: 'Margins', x: '3%', y: '68%', r: '-8deg' },
              { q: 'Who are my top 10 customers this year?', tag: 'Customers', x: '79%', y: '0%', r: '8deg' },
              { q: 'Which customers have overdue payments?', tag: 'Receivables', x: '67%', y: '33%', r: '-9deg' },
              { q: 'Which products generate the highest margins?', tag: 'Products', x: '77%', y: '66%', r: '10deg' },
              { q: 'How did our sales perform last month?', tag: 'Sales', x: '40%', y: '72%', r: '3deg', last: true },
            ].map((c) => (
              <div class:list={['cl-q', { 'cl-q--last': c.last }]} style={`--x:${c.x};--y:${c.y};--r:${c.r}`}>
                <div class="rounded-3xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 px-4 py-6 sm:px-6 sm:py-8 text-center transition-transform duration-300 hover:-translate-y-1">
                  <p class="text-sm sm:text-base font-semibold leading-snug text-gray-900 dark:text-gray-100">“{c.q}”</p>
                  <p class="mt-3 text-xs sm:text-sm text-gray-500 dark:text-gray-400">{c.tag}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

  {phase === 'B' && (
    <>
      <!-- ══════════ PHASE B · 3b. CLARIOR IN ACTION (tabbed showcase, layout from the reference) ══════════
           Example questions, names and figures in the chat mock-ups are illustrative. -->
      <section id="clarior-in-action" class="not-prose bg-white dark:bg-slate-900 py-16 md:py-20 scroll-mt-[72px]">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <h2 class="text-center text-4xl md:text-6xl font-bold leading-tight tracking-tight font-heading text-heading dark:text-white mb-8 md:mb-8">Explore Clarior in action</h2>
          <div class="ia-tabs" role="tablist" aria-label="Clarior capabilities">
            <button type="button" role="tab" id="ia-tab-engage" aria-controls="ia-panel-engage" aria-selected="true" tabindex="0" class="ia-tab" data-ia-tab="engage">
              Engage
            </button>
            <button type="button" role="tab" id="ia-tab-respond" aria-controls="ia-panel-respond" aria-selected="false" tabindex="-1" class="ia-tab" data-ia-tab="respond">
              Respond
            </button>
            <button type="button" role="tab" id="ia-tab-summarize" aria-controls="ia-panel-summarize" aria-selected="false" tabindex="-1" class="ia-tab" data-ia-tab="summarize">
              Summarize
            </button>
            <button type="button" role="tab" id="ia-tab-suggestions" aria-controls="ia-panel-suggestions" aria-selected="false" tabindex="-1" class="ia-tab" data-ia-tab="suggestions">
              Smart suggestions
            </button>
            <button type="button" role="tab" id="ia-tab-insights" aria-controls="ia-panel-insights" aria-selected="false" tabindex="-1" class="ia-tab" data-ia-tab="insights">
              Insights
            </button>
          </div>
          <div class="ia-card" data-ia>
          <div role="tabpanel" id="ia-panel-engage" aria-labelledby="ia-tab-engage" class="ia-panel is-active grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-12 items-center">
            <div class="px-8 pt-10 lg:p-0 lg:pl-14">
              <h3 class="text-3xl md:text-5xl font-bold leading-tight tracking-tight font-heading text-white mb-6">Generative AI powered 24/7 online AI assistant</h3>
              <p class="text-lg text-white/80 leading-relaxed">Clarior is available around the clock. Your team asks questions about SAP Business One in plain language, whenever they need an answer, with no reports to build and no one to wait for.</p>
            </div>
            <div class="ia-stage" aria-hidden="true">
              <div class="ia-chat">
                    <div class="ia-row ia-row-user ia-in" style="--d:.1s">
                      <div class="ia-user">
                        <p class="ia-meta"><b>You</b> 11:42 PM</p>
                        <p>What were our sales last month by region?</p>
                      </div>
                      <span class="ia-avatar">You</span>
                    </div>
                <div class="ia-row ia-in" style="--d:.9s">
                  <span class="ia-bot"><img src="/uploads/clarior-icon.svg" width="20" height="18" alt="" class="w-5 h-5 object-contain" /></span>
                  <div class="ia-ai">
                    <p class="ia-meta"><b>Clarior</b> 11:42 PM<b></b></p>
                    <p>Here are last month’s sales by region.</p>
                        <div class="ia-table"><div><span>North</span><b>1,240,000</b></div><div><span>South</span><b>986,500</b></div><div><span>West</span><b>742,300</b></div><div><span>East</span><b>618,900</b></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" id="ia-panel-respond" aria-labelledby="ia-tab-respond" class="ia-panel grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-12 items-center" inert>
            <div class="px-8 pt-10 lg:p-0 lg:pl-14">
              <h3 class="text-3xl md:text-5xl font-bold leading-tight tracking-tight font-heading text-white mb-6">AI powered natural language reply</h3>
              <p class="text-lg text-white/80 leading-relaxed">Clarior understands the question behind the words and replies in clear, natural language, with the figures you need as a table, chart or dashboard.</p>
            </div>
            <div class="ia-stage" aria-hidden="true">
              <div class="ia-chat">
                    <div class="ia-row ia-row-user ia-in" style="--d:.1s">
                      <div class="ia-user">
                        <p class="ia-meta"><b>You</b> 10:05 AM</p>
                        <p>How did our gross margin change in October?</p>
                      </div>
                      <span class="ia-avatar">You</span>
                    </div>
                <div class="ia-row ia-in" style="--d:.9s">
                  <span class="ia-bot"><img src="/uploads/clarior-icon.svg" width="20" height="18" alt="" class="w-5 h-5 object-contain" /></span>
                  <div class="ia-ai">
                    <p class="ia-meta"><b>Clarior</b> 10:05 AM<b></b></p>
                    <p>Gross margin was <strong>27%</strong> in October, down from <strong>31%</strong> in September.</p>
                        <p>The largest decreases were in:</p>
                        <div class="ia-bars"><div><span>Packaging</span><i style="--w:72%"></i><b>−6 pts</b></div><div><span>Spare parts</span><i style="--w:48%"></i><b>−4 pts</b></div><div><span>Consumables</span><i style="--w:24%"></i><b>−2 pts</b></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" id="ia-panel-summarize" aria-labelledby="ia-tab-summarize" class="ia-panel grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-12 items-center" inert>
            <div class="px-8 pt-10 lg:p-0 lg:pl-14">
              <h3 class="text-3xl md:text-5xl font-bold leading-tight tracking-tight font-heading text-white mb-6">Summarise each moment</h3>
              <p class="text-lg text-white/80 leading-relaxed">Ask for a summary of any day, week or month, and Clarior turns your ERP activity into a short, readable overview.</p>
            </div>
            <div class="ia-stage" aria-hidden="true">
              <div class="ia-chat">
                    <div class="ia-row ia-row-user ia-in" style="--d:.1s">
                      <div class="ia-user">
                        <p class="ia-meta"><b>You</b> 6:15 PM</p>
                        <p>Summarise today’s activity</p>
                      </div>
                      <span class="ia-avatar">You</span>
                    </div>
                <div class="ia-row ia-in" style="--d:.9s">
                  <span class="ia-bot"><img src="/uploads/clarior-icon.svg" width="20" height="18" alt="" class="w-5 h-5 object-contain" /></span>
                  <div class="ia-ai">
                    <p class="ia-meta"><b>Clarior</b> 6:15 PM<b></b></p>
                    <p>Here’s today at a glance:</p>
                        <ul class="ia-list"><li><b>42</b> sales orders created, totalling 186,400</li><li><b>12</b> deliveries still pending</li><li><b>8</b> purchase orders received</li><li><b>3</b> invoices now more than 60 days overdue</li></ul>
                  </div>
                </div>
              </div>
            </div>
