---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import HeroOrbital from '~/components/widgets/HeroOrbital.astro';

import LogoBar from '~/components/widgets/LogoBar.astro';
import ProblemSplit from '~/components/widgets/ProblemSplit.astro';
import FeaturesGrid from '~/components/widgets/FeaturesGrid.astro';
import FeaturesHighlights from '~/components/widgets/FeaturesHighlights.astro';
import FeaturesBento from '~/components/widgets/FeaturesBento.astro';
import SecuritySplit from '~/components/widgets/SecuritySplit.astro';
import ToolsMarquee from '~/components/widgets/ToolsMarquee.astro';
import TestimonialsGrid from '~/components/widgets/TestimonialsGrid.astro';
import FaqAccordion from '~/components/widgets/FaqAccordion.astro';
import CtaBanner from '~/components/widgets/CtaBanner.astro';

import { headerData } from '~/navigation';

const metadata = {
  title: 'Intelligent PO-to-SO & Invoice Automation for SAP | UpBuff',
  description:
    'Automate SAP S/4HANA and SAP Business One with UpBuff AI Automation. Intelligent PO-to-SO conversion, AI vendor invoice processing, real-time master data validation, exception intelligence, and Chat with ERP — with full human-in-the-loop control and audit transparency.',
  canonical: 'https://www.upbuff.com/products/intelligent-po-to-so-invoice-automation/',
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
    url: 'https://www.upbuff.com/products/intelligent-po-to-so-invoice-automation',
    title: 'Intelligent PO-to-SO & Invoice Automation for SAP | UpBuff',
    description:
      'Intelligent PO-to-SO & invoice automation for SAP S/4HANA and SAP Business One. Eliminate manual ERP data entry with Generative AI, intelligent validation, and Chat with ERP.',
    image: 'https://www.upbuff.com/images/intelligent-po-to-so-invoice-automation-og.jpg',
  },
  twitter: {
    cardType: 'summary_large_image',
    title: 'Intelligent PO-to-SO & Invoice Automation | UpBuff',
    description:
      'AI agents that read POs, post sales orders, process vendor invoices, and answer ERP questions — natively integrated with SAP S/4HANA and SAP Business One.',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <meta name="author" content="UpBuff Technologies" />
    <meta
      name="keywords"
      content="AI Automation for SAP, SAP S/4HANA Automation, SAP Business One Automation, AI PO to SO Automation, AI Invoice Processing, ERP Workflow Automation, Generative AI for SAP, AI ERP Integration, Warehouse Automation SAP, AI Analytics Dashboard, Chat with ERP"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "UpBuff Intelligent PO-to-SO and Invoice Automation",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "AI automation platform for SAP S/4HANA and SAP Business One that automates PO-to-SO conversion, vendor invoice processing, master data validation, exception handling, and natural-language ERP analytics with human-in-the-loop control.",
      "url": "https://www.upbuff.com/products/intelligent-po-to-so-invoice-automation",
      "provider": { "@type": "Organization", "name": "UpBuff Technologies", "url": "https://www.upbuff.com" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.upbuff.com/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.upbuff.com/products" },
        { "@type": "ListItem", "position": 3, "name": "Intelligent PO-to-SO and Invoice Automation", "item": "https://www.upbuff.com/products/intelligent-po-to-so-invoice-automation" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What is Intelligent PO-to-SO and Invoice Automation?", "acceptedAnswer": { "@type": "Answer", "text": "It is an AI-driven automation platform that acts as a digital workforce for SAP — reading purchase orders, creating sales orders, processing vendor invoices, validating master data, and generating ERP insights, all integrated with SAP S/4HANA and SAP Business One." } },
        { "@type": "Question", "name": "How does AI PO-to-SO automation work?", "acceptedAnswer": { "@type": "Answer", "text": "AI agents read customer Purchase Orders from email or portals using document understanding, validate the data against SAP master data and pricing, and automatically create Sales Orders in SAP while routing exceptions for human review." } },
        { "@type": "Question", "name": "Does it work with SAP S/4HANA and SAP Business One?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The AI automation platform integrates with both SAP S/4HANA and SAP Business One using secure ERP APIs, keeping SAP as the authoritative system of record." } },
        { "@type": "Question", "name": "Is human control maintained?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A human-in-the-loop confidence model lets teams start with manual approvals and gradually move to fully automated posting as confidence in the AI workflows grows. Exceptions are always routed for manual review." } },
        { "@type": "Question", "name": "What is Chat with ERP?", "acceptedAnswer": { "@type": "Answer", "text": "Chat with ERP lets business users interact with SAP using natural language to generate analytical reports, inventory insights, sales analysis, and operational KPIs instantly." } },
        { "@type": "Question", "name": "Is it secure and auditable?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every AI action, validation, approval, and ERP posting is encrypted, traceable, and securely logged for operational compliance and full audit transparency." } }
      ]
    })} />
  </Fragment>

  <Fragment slot="announcement" />

  <!-- ── 1. HERO ───────────────────────────────────────────────── -->
  <HeroOrbital
    tagline="Intelligent PO-to-SO and Invoice Automation"
    title="Automate Your SAP Operations with AI"
    subtitle="UpBuff AI Automation delivers intelligent PO-to-SO and invoice automation for SAP S/4HANA and SAP Business One. AI agents eliminate manual data entry, accelerate order processing, reduce errors, and improve decision-making using Generative AI — while keeping complete human control and audit transparency."
    actions={[
      { text: 'Request Demo',       href: '/contact', variant: 'primary' },
      { text: 'Talk to Our Experts', href: '/contact', variant: 'secondary' },
    ]}
    centerLogo='<svg viewBox="0 0 48 48" class="w-12 h-12" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="22" fill="white" fill-opacity="0.15"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="18" font-weight="bold" font-family="system-ui">AI</text></svg>'
    centerColor="#1d4ed8"
    avatars={[
      { src: '/uploads/logo/sap-integration-with-upbuff-crm.png',     alt: 'SAP integration',       position: 'top' },
      { src: '/uploads/logo/gmail-integration-with-upbuff-crm.png',   alt: 'Email PO intake',       position: 'bottom-left' },
      { src: '/uploads/logo/power-bi-integration-with-upbuff-crm.png',alt: 'AI analytics',          position: 'bottom-right' },
      { src: '/uploads/logo/outlook-integration-with-upbuff-crm.png', alt: 'Invoice intake',        position: 'top-left' },
    ]}
    badges={[
      { label: 'PO → SO',          position: 'left' },
      { label: 'Invoice AI',       position: 'right' },
      { label: 'Chat with ERP',    position: 'bottom' },
    ]}
  />

  <!-- ── 2. LOGO BAR ──────────────────────────────────────────── -->
  <LogoBar
    label="Trusted by SAP enterprises &amp; partners worldwide"
    logos={[
      { src: '/uploads/ideaForge-logo.svg',          alt: 'ideaForge logo' },
      { src: '/uploads/jnk-chemdist-logo.svg',        alt: 'jnk chemdist logo' },
      { src: '/uploads/molygraph-logo.svg',       alt: 'molygraph logo' },
      { src: '/uploads/ncc-streetscape-logo.svg',       alt: 'ncc streetscape logo' },
      { src: '/uploads/roofsol-logo.svg',         alt: 'roofsol logo' },
      { src: '/uploads/the-wine-source-logo.svg',        alt: 'the wine source logo' },
    ]}
  />

  <!-- ── 3. PROBLEM ───────────────────────────────────────────── -->
  <ProblemSplit
    tagline="Problem"
    title="Manual ERP operations slow down growth"
    subtitle="Traditional data entry processes are time-consuming, error-prone, and difficult to scale. As order and invoice volumes grow, manual SAP operations become a bottleneck that drains productivity and introduces costly mistakes."
    items={[
      {
        title: 'Slow, manual data entry',
        description: 'Customer POs and vendor invoices are keyed into SAP by hand — consuming hours of effort and delaying order processing and fulfilment.',
      },
      {
        title: 'Error-prone transactions',
        description: 'Manual entry introduces pricing mismatches, wrong item codes, duplicate documents, and tax errors that ripple downstream across the ERP.',
      },
      {
        title: 'No real-time validation',
        description: 'Without automated checks against master data, pricing rules, and inventory, errors are caught late — after they have already impacted operations.',
      },
      {
        title: 'Hard to scale operations',
        description: 'Growing transaction volumes mean hiring more staff. Repetitive ERP work limits scalability and keeps skilled users tied to low-value tasks.',
      },
    ]}
  />

  <!-- ── 4. FEATURES GRID ─────────────────────────────────────── -->
  <FeaturesGrid
    tagline="AI Automation Solutions"
    title="A digital workforce for your SAP environment"
    subtitle="UpBuff introduces a next-generation AI Automation Platform that works seamlessly with SAP S/4HANA and SAP Business One to automate repetitive processes — without losing human control."
    items={[
      {
        icon: 'tabler:file-import',
        title: 'AI PO-to-SO Automation',
        description: 'Automatically convert customer Purchase Orders into Sales Orders using AI-powered document understanding and ERP integration — from email or portal to SAP, hands-free.',
      },
      {
        icon: 'tabler:receipt',
        title: 'AI Vendor Invoice Processing',
        description: 'Eliminate manual invoice entry with intelligent invoice extraction, validation, and SAP posting workflows — accelerating accounts payable and reducing errors.',
      },
      {
        icon: 'tabler:database-search',
        title: 'AI Master Data Validation',
        description: 'Validate customer codes, item masters, pricing, taxes, and GRN information in real time before posting transactions — preventing downstream errors.',
      },
      {
        icon: 'tabler:alert-triangle',
        title: 'Exception Intelligence & Human Review',
        description: 'AI automatically identifies mismatches, missing information, pricing issues, or duplicate transactions and alerts authorized users for intervention.',
      },
      {
        icon: 'tabler:message-chatbot',
        title: 'AI Analytics & Chat with ERP',
        description: 'Interact with SAP using natural language. Generate analytical reports, inventory insights, sales analysis, and operational KPIs instantly using AI.',
      },
      {
        icon: 'tabler:shield-lock',
        title: 'Audit-Ready Automation',
        description: 'Every AI action, validation, approval, and ERP posting is securely logged for compliance and traceability — full transparency across every workflow.',
      },
    ]}
  />

  <!-- ── 5. HIGHLIGHTS (Platform pillars) ─────────────────────── -->
  <FeaturesHighlights
    tagline="Platform"
    title="An intelligent automation layer<br />for SAP enterprises"
    subtitle="UpBuff AI agents work alongside your team — automating the repetitive, surfacing the exceptions, and keeping humans in control of every critical decision."
    items={[
      {
        title: 'Generative AI for SAP',
        description: 'AI agents read documents, understand business context, and act on SAP S/4HANA and SAP Business One — converting unstructured POs and invoices into clean ERP transactions.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gray-50 p-6"><div class="bg-white rounded-2xl shadow-md w-64 p-4 flex flex-col items-center"><div class="grid grid-cols-2 w-full text-center"><div class="flex flex-col items-center gap-1"><div class="px-3 py-1.5 bg-blue-50 text-blue-700 text-xs font-semibold rounded-lg border border-blue-100">PO &amp; Invoice</div><span class="text-[10px] text-gray-400">Email · Portal</span></div><div class="flex flex-col items-center gap-1"><div class="px-3 py-1.5 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-lg border border-indigo-100">S/4HANA · B1</div><span class="text-[10px] text-gray-400">OData · Service Layer</span></div></div><div class="grid grid-cols-2 w-full relative h-5"><div class="flex justify-center"><div class="w-px h-5 bg-gray-200 overflow-hidden relative"><div class="absolute inset-0 bg-blue-400 animate-[flowY_1.8s_linear_infinite]"></div></div></div><div class="flex justify-center"><div class="w-px h-5 bg-gray-200 overflow-hidden relative"><div class="absolute inset-0 bg-blue-400 animate-[flowY_1.8s_linear_infinite]"></div></div></div></div><div class="flex items-center justify-center"><div class="px-4 py-2 bg-gray-900 text-white text-xs font-semibold rounded-lg shadow animate-pulse">UpBuff AI Automation Layer</div></div><div class="flex justify-center w-full h-5"><div class="w-px h-5 bg-gray-200 overflow-hidden relative"><div class="absolute inset-0 bg-green-400 animate-[flowY_1.8s_linear_infinite]"></div></div></div><div class="flex justify-center"><div class="px-3 py-1.5 bg-green-50 text-green-700 text-xs font-semibold rounded-lg border border-green-100">Sales Order · Invoice Posted</div></div><div class="text-[10px] text-gray-400 text-center">Validate · Approve · Post · Audit</div></div></div>'
      },
      {
        title: 'Human-in-the-Loop Confidence',
        description: 'Start with manual approvals and gradually move to fully automated ERP posting once your team gains confidence in the AI workflows. Exceptions always route to a human.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gray-50 p-6"><div class="bg-white rounded-2xl shadow-md w-48 p-4 flex flex-col gap-3 animate-[fadeIn_0.6s_ease-out]"><div class="h-3 bg-gray-200 rounded w-3/4 overflow-hidden relative"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/60 to-transparent animate-[shimmer_1.5s_infinite]"></div></div><div class="h-3 bg-gray-100 rounded w-full overflow-hidden relative"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/60 to-transparent animate-[shimmer_1.5s_infinite]"></div></div><div class="mt-1 bg-gray-100 rounded-lg px-3 py-2 flex items-center justify-between text-xs text-gray-600"><span>Exception found</span><span class="px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 text-[10px] font-medium animate-pulse">Review</span></div><div class="h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white text-xs font-medium mt-1">Approve &amp; Post to SAP</div></div></div>',
      },
      {
        title: 'Real-Time ERP Intelligence',
        description: 'Ask questions in plain language and get instant analytical reports, inventory insights, and operational KPIs — turning SAP into a system you can simply talk to.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gray-50 p-6"><div class="bg-white rounded-2xl shadow-md w-52 p-4 flex flex-col gap-3 animate-[fadeIn_0.6s_ease-out]"><div class="h-3 bg-gray-200 rounded w-2/3 overflow-hidden relative"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/60 to-transparent animate-[shimmer_1.5s_infinite]"></div></div><div class="bg-gray-100 rounded-lg px-3 py-2 text-xs text-gray-600">“Show me top 5 customers by sales this month”</div><div class="h-3 bg-gray-100 rounded w-full overflow-hidden relative"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/60 to-transparent animate-[shimmer_1.5s_infinite]"></div></div><div class="h-3 bg-gray-100 rounded w-5/6 overflow-hidden relative"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/60 to-transparent animate-[shimmer_1.5s_infinite]"></div></div><div class="text-[10px] text-gray-400 text-center">Chat with ERP · Live insights</div></div></div>',
      },
    ]}
  />

  <!-- ── 6. HOW IT WORKS (Bento) ───────────────────────────────── -->
  <FeaturesBento
    tagline="How It Works"
    title="How the AI Automation works"
    subtitle="From document capture to audited ERP posting — AI handles the repetitive flow while your team stays in control of every exception and approval."
    items={[
      {
        wide: true,
        title: '1. Capture & Understand',
        description: 'AI agents monitor emails, portals, and uploaded documents to extract business data intelligently — reading customer Purchase Orders and vendor invoices with document understanding, no templates or manual keying required.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-6"><div class="flex items-center gap-4"><div class="flex flex-col gap-2"><div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-lg border border-gray-100"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div><span class="text-[10px] text-gray-500 text-center">Email</span></div><div class="flex flex-col gap-2"><div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-lg border border-gray-100"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg></div><span class="text-[10px] text-gray-500 text-center">PO / Invoice</span></div><div class="w-10 h-1 bg-gray-200 rounded overflow-hidden relative self-center mb-4"><div class="absolute inset-0 bg-blue-400 animate-[flowX_1.6s_linear_infinite]"></div></div><div class="flex flex-col gap-2"><div class="w-16 h-16 rounded-2xl bg-gray-900 flex items-center justify-center shadow-lg animate-pulse"><span class="text-xs font-bold text-white">AI</span></div><span class="text-[10px] text-gray-500 text-center">Understands</span></div></div></div>',
      },
      {
        wide: true,
        title: '2. Validate & Verify',
        description: 'Extracted data is cross-checked against SAP master data, pricing rules, tax structures, and inventory availability in real time — catching mismatches, missing fields, and duplicates before anything reaches the ERP.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-cyan-50 to-blue-100 p-6"><div class="bg-white rounded-2xl shadow-lg border border-gray-100 w-60 p-4 flex flex-col gap-2.5"><div class="flex items-center justify-between text-xs"><span class="text-gray-600">Master data</span><span class="w-4 h-4 rounded-full bg-green-100 flex items-center justify-center animate-[fadeIn_0.5s_ease-out]"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span></div><div class="flex items-center justify-between text-xs"><span class="text-gray-600">Pricing &amp; tax</span><span class="w-4 h-4 rounded-full bg-green-100 flex items-center justify-center animate-[fadeIn_0.7s_ease-out]"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span></div><div class="flex items-center justify-between text-xs"><span class="text-gray-600">Inventory</span><span class="w-4 h-4 rounded-full bg-green-100 flex items-center justify-center animate-[fadeIn_0.9s_ease-out]"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></span></div><div class="flex items-center justify-between text-xs"><span class="text-gray-600">Duplicate check</span><span class="px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 text-[10px] font-medium animate-pulse">Review</span></div></div></div>',
      },
      {
        title: '3. Approve & Automate',
        description: 'Validated transactions are automatically posted into SAP S/4HANA or SAP Business One, while exceptions are routed for manual approval — letting you scale automation at your own pace.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-6"><div class="flex flex-col items-center gap-2"><div class="px-3 py-1.5 bg-white rounded-lg shadow border border-gray-100 text-xs font-semibold text-blue-700">Validated</div><div class="w-px h-5 bg-gray-200 overflow-hidden relative"><div class="absolute inset-0 bg-green-400 animate-[flowY_1.6s_linear_infinite]"></div></div><div class="w-16 h-16 rounded-2xl bg-white flex items-center justify-center shadow-lg border border-gray-100 p-2"><img src="/uploads/logo/sap-integration-with-upbuff-crm.png" alt="SAP" class="w-full h-full object-contain" /></div><span class="text-[10px] text-gray-500">Posted to SAP</span></div></div>',
      },
      {
        title: '4. Audit & Visibility',
        description: 'Every AI action, validation, approval, and ERP posting is securely logged for compliance and traceability — giving you complete audit transparency across every automated workflow.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-50 to-blue-100 p-6"><div class="bg-white rounded-2xl shadow-lg border border-gray-100 w-52 p-4 flex flex-col gap-2"><div class="flex items-center gap-2 text-[11px] text-gray-600 animate-[fadeIn_0.5s_ease-out]"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>PO read · 10:02</div><div class="flex items-center gap-2 text-[11px] text-gray-600 animate-[fadeIn_0.7s_ease-out]"><span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>Validated · 10:02</div><div class="flex items-center gap-2 text-[11px] text-gray-600 animate-[fadeIn_0.9s_ease-out]"><span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>Approved · 10:03</div><div class="flex items-center gap-2 text-[11px] text-gray-600 animate-[fadeIn_1.1s_ease-out]"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>SO posted · 10:03</div><div class="mt-1 flex items-center gap-1.5 text-[10px] text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Encrypted &amp; traceable</div></div></div>',
      },
      {
        title: 'AI + SAP = Intelligent Operations',
        description: 'Whether you run SAP S/4HANA or SAP Business One, UpBuff AI Automation helps your organization move faster, operate smarter, and scale efficiently — without increasing manpower.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-indigo-50 to-purple-100 p-6"><div class="flex items-center gap-3"><div class="w-16 h-16 rounded-2xl bg-gray-900 flex items-center justify-center shadow-lg animate-pulse"><span class="text-sm font-bold text-white">AI</span></div><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg><div class="w-16 h-16 rounded-2xl bg-white flex items-center justify-center shadow-lg border border-gray-100 p-2"><img src="/uploads/logo/sap-integration-with-upbuff-crm.png" alt="SAP" class="w-full h-full object-contain" /></div></div></div>',
      },
    ]}
  />

  <!-- ── 7. WHY UPBUFF ────────────────────────────────────────── -->
  <SecuritySplit
    tagline="Why Businesses Choose UpBuff"
    title="AI-first SAP automation, built by ERP experts"
    subtitle="We combine Generative AI, workflow automation, and ERP intelligence to create scalable enterprise applications — built by a team that knows SAP deeply."
    features={[
      {
        title: 'SAP Integration Expertise',
        description: 'Built by a team experienced in SAP Business One, SAP S/4HANA, warehouse automation, and enterprise workflow systems — automation that respects ERP integrity.',
        illustration: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 72" class="w-20 h-16" fill="none"><ellipse cx="40" cy="16" rx="28" ry="10" stroke="url(#db1)" stroke-width="2.5"/><path d="M12 16v20c0 5.523 12.536 10 28 10s28-4.477 28-10V16" stroke="url(#db1)" stroke-width="2.5"/><path d="M12 36v16c0 5.523 12.536 10 28 10s28-4.477 28-10V36" stroke="url(#db1)" stroke-width="2.5"/><circle cx="40" cy="38" r="3" fill="#06b6d4"/><defs><linearGradient id="db1" x1="12" y1="0" x2="68" y2="72" gradientUnits="userSpaceOnUse"><stop stop-color="#06b6d4"/><stop offset="1" stop-color="#6366f1"/></linearGradient></defs></svg>',
      },
      {
