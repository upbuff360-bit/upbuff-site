---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import HeroOrbital from '~/components/widgets/HeroOrbital.astro';

import LogoBar from '~/components/widgets/LogoBar.astro';
import ProblemSplit from '~/components/widgets/ProblemSplit.astro';
import FeaturesCarousel from '~/components/widgets/FeaturesCarousel.astro';
import FeaturesGrid from '~/components/widgets/FeaturesGrid.astro';
import ContentSplitCard from '~/components/widgets/ContentSplitCard.astro';
import FeaturesHighlights from '~/components/widgets/FeaturesHighlights.astro';
import ToolsMarquee from '~/components/widgets/ToolsMarquee.astro';
import TestimonialsGrid from '~/components/widgets/TestimonialsGrid.astro';
import FaqAccordion from '~/components/widgets/FaqAccordion.astro';
import SecuritySplit from '~/components/widgets/SecuritySplit.astro';
import CtaBanner from '~/components/widgets/CtaBanner.astro';
import PostCard from '~/components/blog/PostCard.astro';
import { findPostsByIds } from '~/utils/blog';
import { findImage } from '~/utils/images';

import { headerData } from '~/navigation';

const clusterPostIds = [
  'shop-floor-data-capture-sap-business-one',
  'batch-traceability-sap-business-one',
  'sap-business-one-wms-for-manufacturers',
];
const clusterPosts = await findPostsByIds(clusterPostIds);
const clusterWithImages = await Promise.all(
  clusterPosts.map(async (post) => ({ post, image: await findImage(post.image) }))
);

const metadata = {
  title: 'Shop Floor Data Collection for SAP Business One | UpBuff',
  description:
    'Shop floor data collection for SAP Business One: capture confirmations, scrap, downtime and material issue at the work centre, posted to SAP in real time.',
  canonical: 'https://www.upbuff.com/products/erp-integrated-manufacturing-shopfloor',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    url: 'https://www.upbuff.com/products/erp-integrated-manufacturing-shopfloor',
    title: 'Shop Floor Data Collection for SAP Business One | UpBuff',
    description:
      'Collect production data at the work centre and post it to SAP Business One production orders in real time — no paper, no re-entry, no ERP core changes.',
    image: 'https://www.upbuff.com/images/erp-manufacturing-og.jpg',
  },
};

// One source of truth for the visible FAQ and the FAQPage schema,
// so the two can never drift apart.
const faqs = [
  {
    question: 'What is shop floor data collection?',
    answer:
      'Shop floor data collection (SFDC), also called shop floor data capture, means recording production events the moment they happen. That includes operation start and finish, good quantity, scrap, downtime, labour time and material used. Operators record each event at the work centre on a tablet, terminal or phone. It then posts to the production order straight away. No more paper route cards keyed in at the end of the shift.',
  },
  {
    question: 'Does SAP Business One have shop floor data collection built in?',
    answer:
      'No. SAP Business One manages bills of materials, production orders, issue for production, receipt from production and costing. But it has no native operator terminals and no real-time data capture from the work centre. That layer comes from an add-on that connects through the SAP B1 Service Layer and DI API. UpBuff is that add-on.',
  },
  {
    question: 'What data can you collect on the shop floor?',
    answer:
      'You can collect operation confirmations against production orders, good quantity, and scrap and rejects with reason codes. You can also record downtime with reasons, operator and work-centre time, and quality check results. Operators issue material by scanning the batch, and receive finished goods with their batch numbers. UpBuff ties every record to the right production order before it reaches SAP.',
  },
  {
    question: 'What is the difference between shop floor data collection and MES?',
    answer:
      'Shop floor data collection is the capture layer. It gets accurate production data off the floor and into the ERP in real time. A full MES (manufacturing execution system) adds detailed scheduling, sequencing and process control on top. Most SAP Business One manufacturers need the capture layer first. Without accurate floor data, no MES or planning tool can work. UpBuff covers data collection, plus MES-style features such as live work-centre status and dashboards.',
  },
  {
    question: 'Which devices does it run on?',
    answer:
      'It runs on Android and iOS phones and tablets, rugged handheld scanners, industrial touch terminals and any modern web browser. Most plants use a mix: fixed terminals at machines and handhelds for material issue and receipts.',
  },
  {
    question: 'Does it work if the shop floor has no network coverage?',
    answer:
      'Yes. Operators keep recording when connectivity drops. Transactions queue on the device and post to SAP in order, without duplicates, as soon as the connection returns.',
  },
  {
    question: 'Can machines send data automatically?',
    answer:
      'Yes. Machine signals and IoT sensors can feed counts and status into UpBuff alongside operator input. UpBuff matches each signal to the right production order before posting it to SAP.',
  },
  {
    question: 'Does it work with SAP S/4HANA, ECC, Oracle and Epicor as well?',
    answer:
      'Yes. SAP Business One connects through the Service Layer. SAP S/4HANA connects through OData, BAPI and IDoc, and ECC through BAPI and IDoc. Oracle and Epicor connect through their standard integration services. In every case the ERP stays the system of record, and UpBuff never modifies its core.',
  },
];
---

<Layout metadata={metadata}>

  <!-- Structured Data — preserved exactly from original -->
  <Fragment slot="head">
    <meta name="author" content="UpBuff Technologies" />
    <meta property="og:site_name" content="UpBuff Technologies" />
    <meta property="og:image" content="https://www.upbuff.com/images/erp-manufacturing-og.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "UpBuff Technologies",
      "url": "https://www.upbuff.com",
      "logo": "https://www.upbuff.com/logo.png",
      "description": "UpBuff is an ERP Execution Platform extending SAP systems into real-time manufacturing, sales, warehouse, CRM, and field service operations."
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://www.upbuff.com",
      "name": "UpBuff Technologies",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.upbuff.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "UpBuff Shop Floor Data Collection for SAP Business One",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, Android, iOS, Industrial Terminals",
      "description": "Shop floor data collection for SAP Business One, SAP S/4HANA, ECC, Oracle and Epicor: operation confirmations, scrap, downtime, labour time and material issue captured at the work centre and posted to the ERP in real time, without modifying the ERP core.",
      "offers": {
        "@type": "Offer",
        "price": "Contact for pricing",
        "priceCurrency": "USD"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer },
      })),
    })} />
  </Fragment>

  <Fragment slot="announcement" />

  <!-- ══════════════════════════════════════════════════════════
       1. HERO
       Source: Hero2 tagline, title, subtitle, image, actions
       ══════════════════════════════════════════════════════════ -->
  <HeroOrbital
    tagline="Manufacturing &amp; Shop Floor · SAP Business One"
    title="Shop Floor Data Collection for SAP Business One"
    subtitle="Shop floor data collection means recording production events as they happen: confirmations, good quantity, scrap, downtime and material used. UpBuff captures them at the work centre on tablets, terminals and phones. Each one posts to SAP Business One production orders in real time, without modifying the ERP core."
    actions={[
      { text: 'Book a Demo',       href: '/request-demo', variant: 'primary' },
      { text: 'See how it works', href: '#how-it-works', variant: 'secondary' },
    ]}
    image={{
      src: '/uploads/Epicore-Integrated-Manufacturing-Shopfloor.png',
      alt: 'Shop floor data collection screens posting production confirmations to SAP Business One',
    }}
  />

  <!-- ══════════════════════════════════════════════════════════
       2. LOGO BAR
       ══════════════════════════════════════════════════════════ -->
  <LogoBar
    label="Trusted by leading manufacturers &amp; SAP partners worldwide"
    logos={[
      { src: '/uploads/ideaForge-logo.svg',        alt: 'ideaForge logo' },
      { src: '/uploads/jnk-chemdist-logo.svg',      alt: 'jnk chemdist logo' },
      { src: '/uploads/molygraph-logo.svg',         alt: 'molygraph logo' },
      { src: '/uploads/ncc-streetscape-logo.svg',   alt: 'ncc streetscape logo' },
      { src: '/uploads/roofsol-logo.svg',           alt: 'roofsol logo' },
      { src: '/uploads/the-wine-source-logo.svg',   alt: 'the wine source logo' },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       3. PROBLEM SPLIT
       Source: Derived from feature descriptions — each problem
       maps directly to a feature that solves it in the original.
       ══════════════════════════════════════════════════════════ -->
  <ProblemSplit
    tagline="The Problem"
    title="Production runs all day. SAP finds out at the end of the shift."
    subtitle="SAP Business One holds your production orders, BOMs and costing. But it gives operators no way to report from the floor. So teams write data on paper and key it in later. Everything downstream runs on yesterday's numbers."
    items={[
      {
        title: 'Production orders run on paper',
        description: 'Operators work from printed route cards, and someone types the confirmations into SAP hours later. Nobody can say how far along an order is right now. WIP is a guess, and orders close late.',
      },
      {
        title: 'Scrap and downtime are never really recorded',
        description: 'When a machine stops or quality rejects a batch, the reason ends up on a clipboard — or nowhere. Without that data, you cannot see where you lose capacity and material, let alone fix it.',
      },
      {
        title: 'Material issue does not match the line',
        description: 'Someone posts issue for production after the fact, or SAP backflushes it from the BOM. SAP stock drifts away from what is physically on the floor. Production costing is wrong before month-end even starts.',
      },
      {
        title: 'Batch records break at production',
        description: 'Most plants trace batches at receipt and at dispatch, but not through production, where the plant consumes and creates them. That gap is exactly where audits, recalls and customer complaints get expensive.',
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       4. FEATURES CAROUSEL — 4 use cases
       Source: All 4 Content widgets — titles, subtitles,
       bullet items, and image URLs taken verbatim from original.
       ══════════════════════════════════════════════════════════ -->
  <FeaturesCarousel
    tagline="Use Cases"
    title="Shop floor data collection for every kind of production"
    subtitle="Whatever you make, shop floor data collection solves the same problem: the floor knows things SAP does not. These are the patterns we see most."
    items={[
      {
        gradient: '#ffffff',
        title: 'Discrete Manufacturing: Live Production Order Status',
        description: 'Operators confirm each operation at the work centre as they finish it. Supervisors see real WIP by order and machine, and every scrap entry carries a reason. Orders close the day they finish, not the week after.',
        image: '<div class="w-full h-full overflow-hidden"><img src="/uploads/Discrete-Manufacturing.png" class="w-full object-top" alt="Discrete Manufacturing SAP PP Integration" loading="lazy" /></div>',
      },
      {
        gradient: 'linear-gradient(135deg, #065f46 0%, #0f766e 100%)',
        title: 'Process Manufacturing: Batch & Lot Control Through Production',
        description: 'Issue ingredients by scanning the exact batch, and record actual consumption and yield. Receive finished goods with new batch numbers linked to their inputs. That gives you full genealogy from supplier batch to customer shipment.',
        image: '<div class="w-full h-full overflow-hidden"><img src="/uploads/Process-Manufacturing.png" class="w-full object-top" alt="Process Manufacturing Batch Control SAP" loading="lazy" /></div>',
      },
      {
        gradient: 'linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%)',
        title: 'Multi-Plant Operations: One Way of Collecting Data, Every Site',
        description: 'Roll the same work-centre screens and reason codes out to every plant. Output, scrap and downtime then compare cleanly across sites. Each plant still posts to its own warehouses and production orders in SAP.',
        image: '<div class="w-full h-full overflow-hidden"><img src="/uploads/Multi-Plant-Enterprises.png" class="w-full object-top" alt="Multi-Plant Manufacturing SAP Governance" loading="lazy" /></div>',
      },
      {
        gradient: 'linear-gradient(135deg, #003f7c 0%, #0070c0 100%)',
        title: 'Growing Manufacturers on SAP Business One: Paper to Real Time',
        description: 'Replace route cards and end-of-shift data entry with a tablet at each work centre. No new ERP, no MES project — just accurate production data in SAP Business One, the day you go live.',
        image: '<div class="w-full h-full overflow-hidden"><img src="/uploads/SME-Manufacturing.png" class="w-full object-top" alt="Shop floor data collection for SAP Business One manufacturers" loading="lazy" /></div>',
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       5. FEATURES GRID — 6 capabilities
       Source: All 6 Features items — titles, descriptions,
       and icons taken verbatim from original.
       ══════════════════════════════════════════════════════════ -->
  <FeaturesGrid
    id="features"
    tagline="What You Can Collect"
    title="Every production event, captured once, at the work centre"
    subtitle="UpBuff ties each record to the right SAP production order and posts it the moment it happens. Nobody types it in again."
    items={[
      {
        icon: 'tabler:clipboard-check',
        title: 'Operation confirmations',
        description: 'Start, pause and complete operations against SAP production orders from a tablet or terminal at the machine. Order status in SAP is always current.',
      },
      {
        icon: 'tabler:package',
        title: 'Good quantity, scrap & rejects',
        description: 'Report output as you produce it, with a reason code on every scrap and reject. You measure your losses instead of estimating them.',
      },
      {
        icon: 'tabler:clock-pause',
        title: 'Downtime & reasons',
        description: 'Log when a work centre stops and why — changeover, breakdown, no material, no operator. The data you need to recover lost capacity.',
      },
      {
        icon: 'tabler:users',
        title: 'Operator & work-centre time',
        description: 'Capture who worked on which operation, and for how long. You get actual labour and machine time against each production order.',
      },
      {
        icon: 'tabler:barcode',
        title: 'Material issue by scan',
        description: 'Issue components to production orders by scanning item and batch. Consumption in SAP then matches what the line actually used.',
      },
      {
        icon: 'tabler:certificate',
        title: 'Receipt from production & quality checks',
        description: 'Receive finished goods with new batch numbers linked to their inputs. Record quality check results at the point of production.',
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       6. CONTENT SPLIT CARD — SAP compatibility
       Source: Second Features block (id="sap-compatibility") —
       tagline, title, all 4 items, and image taken from original.
       ══════════════════════════════════════════════════════════ -->
  <ContentSplitCard
    id="how-it-works"
    tagline="How It Works With SAP Business One"
    title="It extends SAP Business One. It never modifies it."
    cardTitle="Release in SAP. Execute on the floor. Post back in real time."
    cardDescription="When you release a production order in SAP Business One, it appears on the work-centre screen. Operators issue materials by scanning, confirm each operation, and report good quantity, scrap and downtime. Then they receive finished goods with their batch numbers. Every event posts to SAP through the official <a href='https://help.sap.com/docs/SAP_BUSINESS_ONE/f110a154dd0f4c20bf7f3ebca9eeb794/44fda5d585e94b0bbd9d711584db0b96.html' target='_blank' rel='noopener' class='underline'>SAP Business One Service Layer</a> as it happens. If the network drops, events queue on the device. SAP stays the system of record, and UpBuff installs nothing inside it, so upgrades stay safe. Issue and receipt from production are also where the shop floor meets the stores. See how <a href='/products/erp-integrated-warehouse-inventory' class='underline'>UpBuff's warehouse management for SAP Business One</a> handles that side."
    cardImage="/uploads/SAP-Compatibility-Manufacturing-Shopfloor.png"
    cardGradient="linear-gradient(135deg, #003f7c 0%, #0070c0 50%, #1d4ed8 100%)"
    testimonial={{
      quote: 'We partnered with a team that built a fully integrated SAP Business One ecosystem, expanding from service management into product configuration, portals, mobile apps, and workflows. Their integration expertise and professionalism significantly improved our operational visibility and coordination. It has enabled us to scale our operations with greater efficiency and confidence.',
      name: 'CTO',
      company: 'Ideaforge Technology Ltd',
      avatar: '/uploads/Vivek-Patel-CTO-ideaForge.png',
    }}
    features={[
      {
        icon: 'tabler:check',
        title: 'SAP Business One',
        description: 'Production orders, issue for production and receipt from production, through the Service Layer and DI API. Runs on SQL Server or HANA.',
      },
      {
        icon: 'tabler:check',
        title: 'SAP S/4HANA & ECC',
        description: 'The same shop floor screens against SAP PP and MM, connected through OData, BAPI and IDoc.',
      },
      {
        icon: 'tabler:check',
        title: 'Oracle & Epicor',
        description: 'Connected through their standard integration services — so the shop floor layer survives an ERP change.',
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       7. FEATURES HIGHLIGHTS — 3 pillars
       Source: The 6 original features grouped into 3 pairs:
       • Features 1+2 → Production Execution pillar
       • Feature 3    → Shopfloor Data Capture pillar
       • Features 4+5 → Material & Quality Sync pillar
       Images use the original 4 use case images.
       ══════════════════════════════════════════════════════════ -->
  <FeaturesHighlights
    tagline="What Changes"
    title="What changes when you connect the shop floor to SAP"
    subtitle="Three things plants notice in the first weeks after shop floor data capture goes live."
    items={[
      {
        title: 'You can see production as it happens',
        description: 'Live work-centre status — running, idle, down — and output against plan, from the same data that posts to SAP. Supervisors stop walking the floor to find out where an order is, and planners stop promising dates from stale numbers.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gray-50 p-6"><div class="bg-white rounded-2xl shadow-md w-72 p-4 flex flex-col gap-4"><div class="text-xs font-semibold text-center text-gray-700">Production Control · Live SAP Sync</div><div class="grid grid-cols-2 gap-3"><div class="bg-green-50 border border-green-200 rounded-lg p-2 flex flex-col items-center gap-1"><span class="text-[10px] text-gray-500">WC-01</span><span class="text-sm font-bold text-green-600">Running</span><span class="text-[10px] text-gray-400">Output: 120</span></div><div class="bg-yellow-50 border border-yellow-200 rounded-lg p-2 flex flex-col items-center gap-1"><span class="text-[10px] text-gray-500">WC-02</span><span class="text-sm font-bold text-yellow-600 animate-pulse">Idle</span><span class="text-[10px] text-gray-400">Waiting</span></div><div class="bg-green-50 border border-green-200 rounded-lg p-2 flex flex-col items-center gap-1"><span class="text-[10px] text-gray-500">WC-03</span><span class="text-sm font-bold text-green-600">Running</span><span class="text-[10px] text-gray-400">Output: 98</span></div><div class="bg-red-50 border border-red-200 rounded-lg p-2 flex flex-col items-center gap-1"><span class="text-[10px] text-gray-500">WC-04</span><span class="text-sm font-bold text-red-600 animate-pulse">Delay</span><span class="text-[10px] text-gray-400">Maintenance</span></div></div><div class="flex items-center justify-center gap-2 text-[10px] text-blue-600"><span class="w-2 h-2 bg-blue-500 rounded-full animate-ping"></span><span>Bi-directional SAP Sync Active</span></div></div></div>',
      },
      {
        title: 'Data goes in once, from the person who knows it',
        description: 'The operator records quantities, scrap, downtime reasons and batches at the work centre. Nobody in the office has to reconstruct them from a route card. No paper, no re-entry, and no delay between the shop floor and SAP Business One.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 to-green-50 p-6"><div class="bg-white rounded-2xl shadow-md w-64 p-4 flex flex-col gap-4"><div class="text-xs font-semibold text-gray-700 text-center">Workstation · Data Capture</div><div class="flex flex-col gap-2"><div class="flex justify-between items-center text-[10px] text-gray-500"><span>Produced</span><span class="font-semibold text-gray-800">120 pcs</span></div><div class="flex justify-between items-center text-[10px] text-gray-500"><span>Scrap</span><span class="font-semibold text-red-600">5 pcs</span></div><div class="flex justify-between items-center text-[10px] text-gray-500"><span>Downtime</span><span class="font-semibold text-yellow-600">12 min</span></div><div class="flex justify-between items-center text-[10px] text-gray-500"><span>Batch</span><span class="font-semibold text-blue-600">B-204</span></div></div><div class="grid grid-cols-3 gap-2 text-[10px]"><div class="bg-gray-100 rounded-lg py-2 text-center">+10</div><div class="bg-gray-100 rounded-lg py-2 text-center">+5</div><div class="bg-gray-100 rounded-lg py-2 text-center text-red-500">Scrap</div></div><div class="bg-green-600 text-white text-xs font-semibold py-2 rounded-lg text-center shadow animate-pulse">Submit to SAP</div><div class="text-[10px] text-green-600 text-center font-medium">Auto sync · No manual entry</div></div></div>',
      },
      {
        title: 'Stock, costing and traceability line up',
        description: 'When operators issue material by scan, SAP consumption matches the line. Stock and production costing are right without month-end corrections. UpBuff links every batch from input to output, giving you traceability through production, the step most audits find missing. Read more in our guide to <a href="/blog/batch-traceability-sap-business-one" class="underline">batch traceability in SAP Business One</a>.',
        image: '<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 to-blue-50 p-6"><div class="bg-white rounded-2xl shadow-md w-64 p-4 flex flex-col items-center gap-4"><div class="text-xs font-semibold text-gray-700">Material Flow · Quality Check</div><div class="flex items-center justify-between w-full"><div class="flex flex-col items-center gap-1"><div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-[10px] text-gray-600">GI</div><span class="text-[10px] text-gray-500">Material</span></div><div class="relative flex-1 mx-2 h-[2px] bg-gray-200 overflow-hidden"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-400 to-transparent animate-[shimmer_1.2s_infinite]"></div></div><div class="flex flex-col items-center gap-1"><div class="w-12 h-12 bg-blue-50 border border-blue-200 rounded-xl flex items-center justify-center text-[10px] text-blue-600 font-semibold animate-pulse">QC</div><span class="text-[10px] text-gray-500">Inspection</span></div><div class="relative flex-1 mx-2 h-[2px] bg-gray-200 overflow-hidden"><div class="absolute inset-0 bg-gradient-to-r from-transparent via-green-400 to-transparent animate-[shimmer_1.2s_infinite]"></div></div><div class="flex flex-col items-center gap-1"><div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center text-[10px] text-green-700 font-semibold">SAP</div><span class="text-[10px] text-gray-500">Posted</span></div></div><div class="flex justify-between w-full text-[10px]"><span class="text-green-600 font-medium">✓ Passed</span><span class="text-red-500 font-medium animate-pulse">Rejected → Rework</span></div><div class="text-[10px] text-blue-600 text-center font-medium">SAP MM · QM Sync · Compliance enforced</div></div></div>',
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════════
       8. TOOLS MARQUEE
       ══════════════════════════════════════════════════════════ -->
  <ToolsMarquee
    title="Integrates with your manufacturing ecosystem"
    description="UpBuff connects your SAP Business One production with the tools your teams already rely on. It works the same way with S/4HANA, ECC, Oracle and Epicor."
    speed={30}
    tools={[
      { name: 'SAP',             logo: '<img src="/uploads/logo/sap-integration-with-upbuff-crm.png" alt="SAP integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
      { name: 'SAP S/4HANA',    logo: '<img src="/uploads/logo/sap-s4-hanna-integration-with-upbuff-crm.png" alt="SAP S/4HANA integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
      { name: 'SAP Business One',logo: '<img src="/uploads/logo/sap-integration-with-upbuff-crm.png" alt="SAP Business One integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
      { name: 'Oracle',          logo: '<img src="/uploads/logo/oracle-integration-with-upbuff-crm.png" alt="Oracle ERP integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
      { name: 'Epicor',          logo: '<img src="/uploads/logo/epicore-integration-with-upbuff-crm.png" alt="Epicor integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
      { name: 'IoT',             logo: '<img src="/uploads/logo/iot-integration.png" alt="IoT integration with UpBuff Manufacturing" class="w-10 h-10 object-contain" />' },
