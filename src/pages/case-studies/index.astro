---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Image from '~/components/common/Image.astro';
import Card from '~/components/case-study/Card.astro';
import { Icon } from 'astro-icon/components';

import { fetchCaseStudies } from '~/utils/case-studies';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

import { headerData } from '~/navigation';

const caseStudies = await fetchCaseStudies();

// Featured = newest case study; rest = remaining.
const [featured, ...rest] = caseStudies;

// Resolve featured image once (the helper is async).
const featuredImage = featured ? await findImage(featured.image) : null;

// Pre-resolve images for the rest of the grid so the JSX map stays synchronous.
const restWithImages = await Promise.all(
  rest.map(async (cs) => ({
    caseStudy: cs,
    image: await findImage(cs.image),
  }))
);

const metadata = {
  title: 'Case Studies | UpBuff Technologies',
  description:
    'See how enterprises extend SAP Business One, Oracle, and Epicor with the UpBuff Execution Platform — real customer stories, real results.',
  canonical: 'https://www.upbuff.com/case-studies/',
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
    url: 'https://www.upbuff.com/case-studies/',
    title: 'UpBuff Case Studies | ERP Execution Success Stories',
    description:
      'Real customer stories from enterprises using UpBuff to extend SAP Business One, Oracle, and Epicor into mobile field execution.',
  },
  twitter: {
    cardType: 'summary_large_image',
    title: 'UpBuff Case Studies | Customer Success Stories',
    description: 'Real customer stories from enterprises using the UpBuff Execution Platform.',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <meta name="author" content="UpBuff Technologies" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': 'https://www.upbuff.com/case-studies/#collection',
        name: 'UpBuff Case Studies',
        url: 'https://www.upbuff.com/case-studies/',
        description: metadata.description,
        isPartOf: { '@id': 'https://www.upbuff.com/#website' },
        inLanguage: 'en',
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: caseStudies.length,
          itemListElement: caseStudies.slice(0, 10).map((cs, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: 'https://www.upbuff.com/' + cs.permalink,
            name: cs.title,
          })),
        },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        '@id': 'https://www.upbuff.com/case-studies/#breadcrumb',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.upbuff.com/' },
          { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://www.upbuff.com/case-studies/' },
        ],
      })}
    />
  </Fragment>

  <Fragment slot="announcement" />

  <Fragment slot="header">
    <Header
      {...headerData}
      theme="white"
      actions={[{ variant: 'primary', text: 'Request Demo', href: '/request-demo' }]}
      isSticky
    />
  </Fragment>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="bg-gray-50 border-b border-gray-200 not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-gray-200 bg-white shadow-sm mb-5">
        <span class="w-2 h-2 rounded-full bg-[rgb(39,174,97)] shrink-0"></span>
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Customer Stories</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight mb-4 max-w-3xl">
        Case Studies
      </h1>
      <p class="text-gray-600 text-lg leading-relaxed max-w-2xl">
        Real enterprises, real ERP execution wins — see how customers extended SAP Business One,
        Oracle, and Epicor into field, warehouse, and shopfloor operations with UpBuff.
      </p>
    </div>
  </section>

  <!-- ── Featured case study ───────────────────────────────── -->
  {
    featured && (
      <section class="not-prose bg-white border-b border-gray-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
          <a
            href={'/' + featured.permalink}
            class="group grid md:grid-cols-2 gap-8 md:gap-10 items-center"
          >
            <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-gray-100 shadow-sm">
              {featuredImage && (
                <Image
                  src={featuredImage}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  widths={[400, 768, 1024]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  alt={featured.title}
                  width={1024}
                  height={640}
                  loading="eager"
                  decoding="async"
                />
              )}
              <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-xs font-semibold text-gray-900 shadow-sm">
                <Icon name="tabler:sparkles" class="w-3.5 h-3.5 text-[rgb(39,174,97)]" />
                Featured
              </span>
            </div>

            <div>
              {featured.category && (
                <span class="inline-flex text-xs font-semibold text-[rgb(39,174,97)] uppercase tracking-widest mb-3">
                  {featured.category.title}
                </span>
              )}
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 leading-tight tracking-tight mb-3 group-hover:text-primary transition-colors">
                {featured.title}
              </h2>
              {featured.excerpt && (
                <p class="text-gray-600 text-base md:text-lg leading-relaxed mb-5">
                  {featured.excerpt}
                </p>
              )}
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
                {featured.author && (
                  <span class="font-medium text-gray-900">{featured.author}</span>
                )}
                {featured.author && <span class="text-gray-300">·</span>}
                <time datetime={featured.publishDate.toISOString()}>
                  {getFormattedDate(featured.publishDate)}
                </time>
                {featured.readingTime && (
                  <>
                    <span class="text-gray-300">·</span>
                    <span>{featured.readingTime} min read</span>
                  </>
                )}
              </div>
              <span class="inline-flex items-center gap-1.5 mt-6 text-sm font-semibold text-gray-900 group-hover:text-primary transition-colors">
                Read case study
                <Icon
                  name="tabler:arrow-right"
                  class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                />
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- ── Case studies grid ─────────────────────────────────── -->
  <section class="not-prose bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      {
        rest.length > 0 ? (
          <>
            <div class="flex items-baseline justify-between mb-8 md:mb-10">
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
                More customer stories
              </h2>
              <span class="text-sm text-gray-500">
                {caseStudies.length}
                {' '}
                {caseStudies.length === 1 ? 'story' : 'stories'}
              </span>
            </div>

            <div class="grid gap-8 md:gap-10 sm:grid-cols-2 lg:grid-cols-3">
              {restWithImages.map(({ caseStudy, image }) => (
                <Card caseStudy={caseStudy} image={image} />
              ))}
            </div>
          </>
        ) : !featured ? (
          <div class="text-center py-16 max-w-lg mx-auto">
            <Icon name="tabler:bookmark-off" class="w-12 h-12 text-gray-300 mx-auto mb-4" />
            <h2 class="text-xl font-semibold text-gray-900 mb-2">No case studies yet</h2>
            <p class="text-gray-500 text-sm leading-relaxed">
              We're preparing customer stories from enterprises running UpBuff alongside their SAP,
              Oracle, and Epicor deployments. Check back soon — or
              {' '}
              <a href="/request-demo" class="text-[rgb(39,174,97)] underline underline-offset-2 hover:no-underline">
                request a live walkthrough
              </a>
              {' '}
              in the meantime.
            </p>
          </div>
        ) : null
      }
    </div>
  </section>
</Layout>
