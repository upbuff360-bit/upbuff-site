  <script>
    const btn      = document.querySelectorAll('[href="#hero-video"]');
    const overlay  = document.getElementById('hero-video-overlay');
    const backdrop = document.getElementById('hero-video-backdrop');
    const closeBtn = document.getElementById('hero-video-close');
    const iframe   = document.getElementById('hero-video-iframe');
    const videoSrc = 'https://www.youtube.com/embed/uhP4tvcec0c?autoplay=1&rel=0&modestbranding=1';

    function openModal(src) {
      if (!overlay || !iframe) return;
      iframe.setAttribute('src', src || videoSrc);
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!overlay || !iframe) return;
      overlay.classList.add('opacity-0', 'pointer-events-none');
      iframe.setAttribute('src', '');
      document.body.style.overflow = '';
    }

    btn?.forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); openModal(b.dataset.videoSrc); }));
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  </script>

