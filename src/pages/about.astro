        { src: '/uploads/shibu-and-rajesh-at-gitex.png',     alt: 'Shiburaj and Rajesh at GITEX',     w: 'w-56', h: 'h-4/5', mt: 'mt-auto' },
        { src: '/uploads/gitex-upbuff-presence.png',         alt: 'UpBuff presence at GITEX',         w: 'w-80', h: 'h-full', mt: 'mt-0'    },
