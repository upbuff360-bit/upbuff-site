      <div class="text-indigo-500 text-8xl font-serif leading-none mb-2 select-none" aria-hidden="true">&ldquo;</div>

      <!-- Slider viewport -->
      <div class="quote-viewport overflow-hidden relative">
        <div class="quote-track flex transition-transform duration-700 ease-in-out">

          <!-- Slide 1 — Shiburaj -->
          <div class="quote-slide w-full shrink-0">
            <blockquote>
              <p class="text-xl md:text-2xl lg:text-3xl font-medium text-white leading-snug md:leading-snug mb-10">
                Our team spans ERP architects, mobile engineers, and integration specialists
                across India and beyond — but our commitment has never changed:
                <span class="text-indigo-400">every enterprise deserves execution speed
                without paying for it with ERP instability.</span>
              </p>
              <footer class="flex items-center justify-center gap-4">
                <div class="w-12 h-12 rounded-xl overflow-hidden ring-white/20 shrink-0 bg-gray-800">
                  <img src="/uploads/shiburaj.png" alt="Shiburaj Krishnapillai" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="text-left">
                  <p class="text-white font-semibold text-sm">Shiburaj Krishnapillai</p>
                  <p class="text-white/40 text-xs mt-0.5">Founder &amp; CEO, UpBuff</p>
                </div>
              </footer>
            </blockquote>
          </div>

          <!-- Slide 2 — Rajesh -->
          <div class="quote-slide w-full shrink-0">
            <blockquote>
              <p class="text-xl md:text-2xl lg:text-3xl font-medium text-white leading-snug md:leading-snug mb-10">
                The market does not need another standalone app. It needs a platform that
                <span class="text-indigo-400">speaks the language of ERP — in real time,
                without compromise, and without ever asking IT to touch the core.</span>
              </p>
              <footer class="flex items-center justify-center gap-4">
                <div class="w-12 h-12 rounded-xl overflow-hidden ring-white/20 shrink-0 bg-gray-800">
                  <img src="/uploads/rajesh.png" alt="Rajesh Kattilepurath" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="text-left">
                  <p class="text-white font-semibold text-sm">Rajesh Kattilepurath</p>
                  <p class="text-white/40 text-xs mt-0.5">Co-founder &amp; Head of Marketing, UpBuff</p>
                </div>
              </footer>
            </blockquote>
          </div>

        </div>
      </div>

      <!-- Dot indicators -->
      <div class="flex items-center justify-center gap-2 mt-10">
        <button class="quote-dot w-2.5 h-2.5 rounded-full bg-indigo-400 scale-125 transition-all duration-300" data-target="0" aria-label="Quote 1"></button>
        <button class="quote-dot w-2.5 h-2.5 rounded-full bg-white/20 transition-all duration-300" data-target="1" aria-label="Quote 2"></button>
      </div>

    </div>
  </section>

  <script>
    (function initQuoteSlider() {
      const track = document.querySelector('.quote-track') as HTMLElement | null;
      const dots   = Array.from(document.querySelectorAll('.quote-dot')) as HTMLElement[];
      const total  = dots.length;
      let current  = 0;
      let timer: ReturnType<typeof setInterval>;

      function goTo(index: number) {
        current = index;
        if (track) track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle('bg-indigo-400', active);
          dot.classList.toggle('scale-125', active);
          dot.classList.toggle('bg-white/20', !active);
        });
      }

      function startTimer() {
        timer = setInterval(() => goTo((current + 1) % total), 6000);
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          clearInterval(timer);
          goTo(Number(dot.dataset.target));
          startTimer();
        });
      });

      goTo(0);
      startTimer();

      document.addEventListener('astro:after-swap', () => {
        clearInterval(timer);
        goTo(0);
        startTimer();
      });
    })();
  </script>

  <!-- ══════════════════════════════════════════════════════════
       5. VISION & MISSION CARDS
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-16 md:py-20 not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div class="rounded-2xl border border-gray-200 bg-white p-8 md:p-10 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
            </svg>
