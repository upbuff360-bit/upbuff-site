---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Breadcrumb from '~/components/blog/Breadcrumb.astro';
import ShareBar from '~/components/blog/ShareBar.astro';
import NewsCard from '~/components/news/NewsCard.astro';
import ArticleBody from '~/components/common/ArticleBody.astro';

import { fetchEvents, findRelatedEvents } from '~/utils/events';
import type { EventItem } from '~/utils/events';
import { getPermalink, getCanonical } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

import { headerData } from '~/navigation';

export const getStaticPaths = (async () => {
  const posts = await fetchEvents();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: EventItem;
}

const { post } = Astro.props;
const { Content } = post;

// Resolve the post image to its optimized form once.
const heroImage = await findImage(post.image);

// Related events (same category / shared tags), images pre-resolved so the JSX map stays synchronous.
const relatedRaw = await findRelatedEvents(post, 3);
const related = await Promise.all(relatedRaw.map(async (p) => ({ post: p, image: await findImage(p.image) })));

// Build canonical URL — prefer explicit metadata override, otherwise derive from path.
const path = getPermalink(post.permalink, 'post');
const canonicalUrl = post.metadata?.canonical || String(getCanonical(path));
const shareUrl = canonicalUrl;

// Open Graph image — use post image if it's a public/external URL string,
// or the built asset URL when the frontmatter uses ~/assets (ImageMetadata).
const rawOgImage =
  typeof post.image === 'string' && (post.image.startsWith('http') || post.image.startsWith('/'))
    ? post.image
    : typeof post.image === 'object' && post.image !== null && 'src' in post.image
      ? (post.image as { src: string }).src
      : 'https://www.upbuff.com/assets/og-image.jpg';
const ogImage = rawOgImage.startsWith('/') ? `https://www.upbuff.com${rawOgImage}` : rawOgImage;
const pageDescription = post.metadata?.description || post.excerpt;

const metadata = {
  title: post.metadata?.title || post.title,
  description: pageDescription,
  canonical: canonicalUrl,
  robots: post.metadata?.robots ?? { index: !post.draft, follow: true },
  openGraph: {
    type: 'article',
    url: canonicalUrl,
    title: post.title,
    description: pageDescription,
    images: [{ url: ogImage }],
    ...(post.metadata?.openGraph ?? {}),
  },
  twitter: {
    cardType: 'summary_large_image',
    title: post.title,
    description: pageDescription,
    ...(post.metadata?.twitter ?? {}),
  },
};

// "March 3, 2026" or "March 3 – March 5, 2026" when an end date is set.
const eventDateLabel = post.eventEndDate
  ? `${getFormattedDate(post.publishDate)} – ${getFormattedDate(post.eventEndDate)}`
  : getFormattedDate(post.publishDate);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Newsroom', href: '/newsroom' },
  { label: 'Events', href: '/newsroom/events' },
  { label: post.title },
];
---

<Layout metadata={metadata} headerTheme="white">
  <Fragment slot="head">
    <meta name="author" content={post.author || 'UpBuff Technologies'} />
    {post.publishDate && <meta property="article:published_time" content={post.publishDate.toISOString()} />}
    {post.updateDate && <meta property="article:modified_time" content={post.updateDate.toISOString()} />}
    {post.author && <meta property="article:author" content={post.author} />}
    {post.authorLinkedIn && <link rel="author" href={post.authorLinkedIn} />}
    {post.category && <meta property="article:section" content={post.category.title} />}
    {post.tags?.map((tag) => <meta property="article:tag" content={tag.title} />)}

    <!-- Event structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Event',
        '@id': canonicalUrl + '#event',
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
        name: post.title,
        description: pageDescription,
        image: ogImage,
        url: canonicalUrl,
        startDate: post.publishDate?.toISOString(),
        ...(post.eventEndDate ? { endDate: post.eventEndDate.toISOString() } : {}),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        ...(post.location
          ? { location: { '@type': 'Place', name: post.location, address: post.location } }
          : {}),
        organizer: {
          '@type': 'Organization',
          name: 'UpBuff Technologies',
          url: 'https://www.upbuff.com',
          logo: { '@type': 'ImageObject', url: 'https://www.upbuff.com/logo.png' },
        },
        keywords: post.tags?.map((t) => t.title).join(', '),
      })}
    />

    <!-- BreadcrumbList structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        '@id': canonicalUrl + '#breadcrumb',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.upbuff.com/' },
          { '@type': 'ListItem', position: 2, name: 'Newsroom', item: 'https://www.upbuff.com/newsroom/' },
          { '@type': 'ListItem', position: 3, name: 'Events', item: 'https://www.upbuff.com/newsroom/events' },
          { '@type': 'ListItem', position: 4, name: post.title, item: canonicalUrl },
        ],
      })}
    />
  </Fragment>

  <Fragment slot="announcement" />


  <article class="not-prose">
    <!-- ── Hero: breadcrumb → title → meta ──────────────────── -->
    <header class="bg-gray-50 border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
        <!-- 1. Breadcrumb FIRST -->
        <Breadcrumb items={breadcrumbItems} class="mb-6" />

        <!-- Optional category pill -->
        {
          post.category && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-gray-200 text-xs font-semibold text-[rgb(39,174,97)] uppercase tracking-widest mb-4">
              {post.category.title}
            </span>
          )
        }

        <!-- 2. Title -->
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 leading-[1.2] tracking-tight mb-4 max-w-[28ch]">
          {post.title}
        </h1>

        {
          post.excerpt && (
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mb-7 max-w-[62ch] font-normal">
              {post.excerpt}
            </p>
          )
        }

        <!-- 3. Created by, date, read time -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-3 text-sm text-gray-600 pt-5 border-t border-gray-200">
          {
            post.author && (
              <div class="flex items-center gap-2.5">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-[rgb(39,174,97)] to-[rgb(24,139,74)] text-white text-xs font-bold shadow-sm">
                  {post.author
                    .split(' ')
                    .map((n) => n[0])
                    .slice(0, 2)
                    .join('')
                    .toUpperCase()}
                </span>
                <div class="leading-tight">
                  <span class="block text-[11px] uppercase tracking-widest text-gray-400 font-semibold">
                    Written by
                  </span>
                  {post.authorLinkedIn ? (
                    <a
                      href={post.authorLinkedIn}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block font-semibold text-gray-900 text-[15px] hover:text-primary transition-colors"
                    >
                      {post.author}
                    </a>
                  ) : (
                    <span class="block font-semibold text-gray-900 text-[15px]">{post.author}</span>
                  )}
                </div>
              </div>
            )
          }

          {post.author && <span class="hidden sm:block w-1 h-1 rounded-full bg-gray-300" />}

          <div class="flex items-center gap-1.5">
            <Icon name="tabler:calendar" class="w-4 h-4 text-gray-400" />
            <time datetime={post.publishDate.toISOString()} class="text-gray-700">
              {eventDateLabel}
            </time>
          </div>

          {
            post.location && (
              <>
                <span class="w-1 h-1 rounded-full bg-gray-300" />
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:map-pin" class="w-4 h-4 text-gray-400" />
                  <span class="text-gray-700">{post.location}</span>
                </div>
              </>
            )
          }

          {
            post.readingTime && (
              <>
                <span class="w-1 h-1 rounded-full bg-gray-300" />
                <div class="flex items-center gap-1.5">
                  <Icon name="tabler:clock" class="w-4 h-4 text-gray-400" />
                  <span class="text-gray-700">{post.readingTime} min read</span>
                </div>
              </>
            )
          }

          {
            post.updateDate && (
              <>
                <span class="w-1 h-1 rounded-full bg-gray-300" />
                <span class="text-xs text-gray-500 italic">
                  Updated {getFormattedDate(post.updateDate)}
                </span>
              </>
            )
          }
        </div>

        {
          post.eventUrl && (
            <a
              href={post.eventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 mt-6 rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[rgb(39,174,97)]"
            >
              Visit event website
              <Icon name="tabler:arrow-up-right" class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </a>
          )
        }
      </div>
    </header>

    <!-- 4. Featured image -->
    {
      heroImage && (
        <div class="bg-white">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 -mt-1 md:-mt-6 pt-6 md:pt-10">
            <Image
              src={heroImage}
              class="w-full max-w-[1000px] mx-auto rounded-2xl shadow-md bg-gray-100 aspect-[10/3] object-cover"
              widths={[400, 700, 1000]}
              sizes="(max-width: 1000px) 100vw, 1000px"
              alt={post.title}
              width={1000}
              height={400}
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      )
    }

    <!-- 5. Content (markdown body) -->
    <div class="bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-10 md:pt-14 pb-8 md:pb-12">
        <ArticleBody>
          {Content && <Content />}
        </ArticleBody>
      </div>
    </div>

    <!-- 6. Tags (non-link labels — the newsroom has no tag archives) -->
    {
      post.tags && post.tags.length > 0 && (
        <div class="bg-white">
          <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-6">
            <div class="flex flex-wrap items-center gap-2">
              <Icon name="tabler:tag" class="w-4 h-4 text-gray-400" />
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest mr-1">
                Tagged:
              </span>
              {post.tags.map((tag) => (
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-xs font-medium text-gray-700">
                  #{tag.title}
                </span>
              ))}
            </div>
          </div>
        </div>
      )
    }

    <!-- 7. Share — closing stage -->
    <div class="bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-12 md:pb-16">
        <ShareBar text={post.title} url={shareUrl} />
      </div>
    </div>

    <!-- ── Back to events -->
    <div class="bg-white border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
        <a
          href="/newsroom/events"
          class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-colors"
        >
          <Icon name="tabler:arrow-left" class="w-4 h-4" />
          Back to all events
        </a>
      </div>
    </div>

    <!-- ── Related events -->
    {
      related.length > 0 && (
        <div class="bg-gray-50 border-t border-gray-100">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
            <div class="not-prose intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              <div class="flex items-baseline justify-between mb-8 md:mb-10">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">More events</h2>
                <a href="/newsroom/events" class="text-sm text-gray-500 hover:text-primary transition-colors">
                  View all events »
                </a>
              </div>
              <div class="grid gap-8 md:gap-10 sm:grid-cols-2 lg:grid-cols-3">
                {related.map(({ post, image }) => (
                  <NewsCard post={post} image={image} />
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }
  </article>
</Layout>
