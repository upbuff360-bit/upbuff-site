---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import type { Post } from '~/types';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  caseStudy: Post;
  image: ImageMetadata | string | null | undefined;
}

const { caseStudy, image } = Astro.props;
const link = '/' + caseStudy.permalink; // permalink is "case-studies/<slug>"
---

<article class="group flex flex-col">
  <a
    href={link}
    class="block aspect-[16/10] overflow-hidden rounded-xl bg-gray-100 mb-5"
  >
    {
      image && (
        <Image
          src={image}
          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          alt={caseStudy.title}
          width={800}
          height={500}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>

  {
    caseStudy.category && (
      <span class="text-xs font-semibold text-[rgb(39,174,97)] uppercase tracking-widest mb-2">
        {caseStudy.category.title}
      </span>
    )
  }

  <h3 class="text-xl font-bold text-gray-900 leading-snug mb-2">
    <a href={link} class="hover:text-primary transition-colors">
      {caseStudy.title}
    </a>
  </h3>

  {
    caseStudy.excerpt && (
      <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-grow">
        {caseStudy.excerpt}
      </p>
    )
  }

  <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-500 mt-auto">
    {caseStudy.author && <span class="font-medium text-gray-700">{caseStudy.author}</span>}
    {caseStudy.author && <span class="text-gray-300">·</span>}
    <time datetime={caseStudy.publishDate.toISOString()}>
      {getFormattedDate(caseStudy.publishDate)}
    </time>
    {
      caseStudy.readingTime && (
        <>
          <span class="text-gray-300">·</span>
          <span>{caseStudy.readingTime} min read</span>
        </>
      )
    }
  </div>
</article>
