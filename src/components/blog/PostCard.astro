---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
  image: ImageMetadata | string | null | undefined;
  /** Whether to show the category pill above the title. Default: true. */
  showCategory?: boolean;
}

const { post, image, showCategory = true } = Astro.props;
const link = getPermalink(post.permalink, 'post');
const hasCategory = showCategory && !!post.category;
---

<article class="group flex flex-col">
  <a
    href={link}
    class="block aspect-[16/10] overflow-hidden rounded-xl bg-gray-100 mb-5"
  >
    {
      image && (
        <Image
          src={image}
          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          alt={post.title}
          width={800}
          height={500}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>

  {
    hasCategory && (
      <a
        href={getPermalink(post.category!.slug, 'category')}
        class="text-xs font-semibold text-[rgb(39,174,97)] uppercase tracking-widest mb-2 hover:underline"
      >
        {post.category!.title}
      </a>
    )
  }

  <h3 class="text-xl font-bold text-gray-900 leading-snug mb-2">
    <a href={link} class="hover:text-primary transition-colors">
      {post.title}
    </a>
  </h3>

  {
    post.excerpt && (
      <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-grow">
        {post.excerpt}
      </p>
    )
  }

  <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-500 mt-auto">
    {
      post.author &&
        (post.authorLinkedIn ? (
          <a
            href={post.authorLinkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-gray-700 hover:text-primary transition-colors"
          >
            {post.author}
          </a>
        ) : (
          <span class="font-medium text-gray-700">{post.author}</span>
        ))
    }
    {post.author && <span class="text-gray-300">·</span>}
    <time datetime={post.publishDate.toISOString()}>
      {getFormattedDate(post.publishDate)}
    </time>
    {
      post.readingTime && (
        <>
          <span class="text-gray-300">·</span>
          <span>{post.readingTime} min read</span>
        </>
      )
    }
  </div>
</article>
