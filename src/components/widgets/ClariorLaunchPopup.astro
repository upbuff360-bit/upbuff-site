<dialog
  id="clarior-launch-popup"
  aria-labelledby="clarior-popup-title"
  aria-describedby="clarior-popup-description"
  class="m-auto w-[calc(100%-2rem)] max-w-2xl border-0 bg-transparent p-0 text-left text-gray-900 backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm"
>
  <div class="relative overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-black/10">
    <div class="relative isolate overflow-hidden bg-slate-950 px-6 pb-8 pt-7 text-white sm:px-10 sm:pb-10 sm:pt-9">
      <div class="absolute -right-16 -top-24 -z-10 h-72 w-72 rounded-full bg-green-500/30 blur-3xl"></div>
      <div class="absolute -bottom-36 right-24 -z-10 h-64 w-64 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute right-5 top-2 -z-10 h-48 w-48 rounded-full border border-white/10 sm:right-12 sm:top-0 sm:h-64 sm:w-64">
        <div class="absolute inset-5 rounded-full border border-white/10"></div>
        <div class="absolute inset-12 rounded-full border border-white/10"></div>
        <div class="absolute right-5 top-12 h-2.5 w-2.5 rounded-full bg-green-300 shadow-[0_0_24px_8px_rgba(134,239,172,0.45)]"></div>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-green-200">
        <span class="h-1.5 w-1.5 rounded-full bg-green-300"></span>
        A new way to explore your ERP
      </div>
      <h2 id="clarior-popup-title" class="mt-5 max-w-lg font-heading text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
        Your ERP is about to answer back.
      </h2>
      <p id="clarior-popup-description" class="mt-4 max-w-md text-sm leading-relaxed text-slate-300 sm:text-base">
        Meet Clarior, conversational AI for SAP Business One. Ask business questions in plain language and discover the answers in your data.
      </p>
    </div>

    <div class="flex flex-col gap-5 px-6 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-10 sm:py-7">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-green-700">Global unveiling</p>
        <p class="mt-1 font-heading text-lg font-bold text-gray-950">November 8 <span class="font-medium text-gray-500">· 6:00 PM IST</span></p>
      </div>
      <a
        href="/clarior"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-green-600/20 transition hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
      >
        Discover Clarior
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <button
      type="button"
      data-clarior-popup-close
      aria-label="Close Clarior launch announcement"
      class="absolute right-4 top-4 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/80"
    >
      <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="m18 6-12 12M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</dialog>

<script>
  const popupStorageKey = 'upbuff-clarior-launch-popup-seen-v2';
  const clariorLaunchAt = new Date('2026-11-08T18:00:00+05:30').getTime();

  function showClariorLaunchPopup() {
    const popup = document.querySelector<HTMLDialogElement>('#clarior-launch-popup');
    if (!popup || Date.now() >= clariorLaunchAt) return;

    try {
      if (localStorage.getItem(popupStorageKey)) return;
      localStorage.setItem(popupStorageKey, '1');
    } catch {
      // Still show the announcement if browser storage is unavailable.
    }

    if (!popup.open) popup.showModal();
  }

  function initClariorLaunchPopup() {
    window.setTimeout(showClariorLaunchPopup, 1200);
  }

  document.addEventListener('astro:page-load', initClariorLaunchPopup);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClariorLaunchPopup, { once: true });
  } else {
    initClariorLaunchPopup();
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const popup = target.closest<HTMLDialogElement>('#clarior-launch-popup');
    if (!popup) return;

    if (target.closest('[data-clarior-popup-close]') || target === popup) popup.close();
  });
</script>
