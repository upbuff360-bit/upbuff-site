---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import type { CallToAction, Widget } from '~/types';

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  /** Primary CTA button */
  action?: CallToAction;
  /** Optional second button (green), e.g. a phone call link */
  secondaryAction?: CallToAction;
  /** Small trust note shown next to the button (e.g. "No credit card required") */
  note?: string;
  /** Icon HTML rendered before the note text (defaults to a green check) */
  noteIcon?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  action,
  secondaryAction,
  note,
  noteIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const actionTarget = action?.target;
---

<!-- Dark CTA card with the animated green particle stream (same design as the home page CTA) -->
<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl ${(classes as Record<string, string>)?.container ?? ''}`}
  bg={bg}
>
  <div class="cta-card relative overflow-hidden rounded-3xl bg-black text-white">
    <canvas class="cta-canvas" data-cta-canvas aria-hidden="true"></canvas>
    <div class="relative z-10 px-8 py-14 md:px-16 md:py-24 max-w-3xl">
      {title && (
        <h2
          class="text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight font-heading text-white mb-6"
          set:html={title}
        />
      )}

      {subtitle && (
        <p class="text-lg md:text-2xl text-white/90 leading-relaxed mb-8" set:html={subtitle} />
      )}

      {(action?.text || secondaryAction?.text || note) && (
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          {action?.text && (
            <a
              href={action.href}
              target={actionTarget}
              rel={actionTarget === '_blank' ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center px-7 py-3 rounded-full bg-white text-black font-semibold text-base hover:bg-gray-200 transition-colors duration-150"
            >
              {action.text}
            </a>
          )}
          {secondaryAction?.text && (
            <a
              href={secondaryAction.href}
              target={secondaryAction.target}
              rel={secondaryAction.target === '_blank' ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-[rgb(39,174,97)] text-white font-semibold text-base hover:bg-[rgb(24,139,74)] transition-colors duration-150"
            >
              {secondaryAction.icon && <Icon name={secondaryAction.icon} class="w-5 h-5 shrink-0" />}
              {secondaryAction.text}
            </a>
          )}
          {note && (
            <span class="inline-flex items-center gap-2 text-sm text-white/80">
              {noteIcon ? (
                <span class="shrink-0" set:html={noteIcon} />
              ) : (
                <Icon name="tabler:circle-check" class="w-5 h-5 shrink-0 text-primary" />
              )}
              <span set:html={note} />
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</WidgetWrapper>

<style>
  .cta-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
</style>

<script>
  // CTA background: green particles flowing along a curved stream (canvas, no libraries).
  // Same animation as Huddle Global on /products/clarior, slowed down via SPEED.
  function initCtaStream() {
    document.querySelectorAll<HTMLCanvasElement>('[data-cta-canvas]').forEach(bindCtaStream);
  }
  function bindCtaStream(canvas: HTMLCanvasElement) {
    if (canvas.dataset.ctaBound) return;
    canvas.dataset.ctaBound = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type P = { t: number; off: number; r: number; a: number; l: number; sp: number; wob: number; ph: number; stray: boolean; sx: number; sy: number };
    let W = 0, H = 0, parts: P[] = [], raf = 0, running = false;

    // Stream path: in from the bottom-left, along the bottom, then up the right side.
    const P0 = [-0.05, 1.08], P1 = [0.55, 0.7], P2 = [1.02, 1.05], P3 = [0.9, -0.08];
    const bez = (t: number) => {
      const u = 1 - t;
      const x = u*u*u*P0[0] + 3*u*u*t*P1[0] + 3*u*t*t*P2[0] + t*t*t*P3[0];
      const y = u*u*u*P0[1] + 3*u*u*t*P1[1] + 3*u*t*t*P2[1] + t*t*t*P3[1];
      const dx = 3*u*u*(P1[0]-P0[0]) + 6*u*t*(P2[0]-P1[0]) + 3*t*t*(P3[0]-P2[0]);
      const dy = 3*u*u*(P1[1]-P0[1]) + 6*u*t*(P2[1]-P1[1]) + 3*t*t*(P3[1]-P2[1]);
      return [x, y, dx, dy];
    };
    const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;
    // Overall animation speed (1 = original Huddle speed; lower = slower)
    const SPEED = 0.4;

    const make = (): P => ({
      t: Math.random(), off: gauss(), r: Math.random() < 0.8 ? 0.5 + Math.random() * 1.3 : 1.8 + Math.random() * 1.8,
      a: 0.45 + Math.random() * 0.55, l: 48 + Math.random() * 22, sp: (0.00025 + Math.random() * 0.0006) * SPEED,
      wob: 2 + Math.random() * 6, ph: Math.random() * Math.PI * 2, stray: Math.random() < 0.06,
      sx: Math.random(), sy: Math.random(),
    });

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(6000, Math.max(1500, W * H / 120)));
      parts = Array.from({ length: n }, make);
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, W, H);
      const minSide = Math.min(W, H);
      for (const p of parts) {
        let x: number, y: number;
        if (p.stray) {
          p.sy -= p.sp * 0.6; if (p.sy < -0.02) { p.sy = 1.02; p.sx = Math.random(); }
          x = p.sx * W; y = p.sy * H;
        } else {
          p.t += p.sp; if (p.t > 1) { p.t = 0; p.off = gauss(); }
          const [bx, by, dx, dy] = bez(p.t);
          const len = Math.hypot(dx * W, dy * H) || 1;
          const nx = -dy * H / len, ny = dx * W / len;               // normal to the stream
          const width = minSide * (0.13 + 0.13 * Math.sin(p.t * Math.PI)); // wider in the middle
          const w = Math.sin((time * SPEED) / 1400 + p.ph) * p.wob;
          x = bx * W + nx * (p.off * width + w);
          y = by * H + ny * (p.off * width + w) - Math.cos((time * SPEED) / 1700 + p.ph) * p.wob;
        }
        const edge = Math.max(0, 1 - Math.abs(p.off) * 0.9);
        ctx.globalAlpha = p.stray ? p.a * 0.4 : p.a * (0.45 + 0.55 * edge);
        ctx.fillStyle = `hsl(150, 62%, ${p.l}%)`;
        ctx.beginPath(); ctx.arc(x, y, p.r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (time: number) => { draw(time); raf = requestAnimationFrame(loop); };
    const start = () => { if (running || reduce) return; running = true; raf = requestAnimationFrame(loop); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize(); draw(0);
    let rt: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { resize(); draw(performance.now()); }, 150); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((e) => (e.some((x) => x.isIntersecting) ? start() : stop())).observe(canvas);
    } else start();
  }
  document.addEventListener('astro:page-load', initCtaStream);
</script>
