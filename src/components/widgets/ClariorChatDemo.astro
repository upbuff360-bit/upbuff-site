---
/**
 * ClariorChatDemo — animated Clarior chat card.
 *
 * Plays a question, typing dots, then the answer table row by row, and replays
 * while it is on screen. Pauses on hover; static for reduced-motion users.
 *
 * Optional flip: pass content in the `back` slot (using the pv-* classes, e.g.
 * pv-panels / pv-panel / pv-bstep) and the card flips to it after `flipAt` ms.
 * Without a back slot it just replays the answer every `cycle` ms.
 *
 * Optional `after` slot (no-flip mode only): extra content shown under the
 * answer inside the same card. Give its elements the pv-step class with a
 * --d delay after the last table row so they fade in once the answer is done.
 *
 * Used on /products/clarior (privacy + data-protection demos, with flip) and in
 * the "What is Conversational BI?" blog post (answer only).
 */
export interface Column {
  label: string;
  /** name = first text column, value = bold number, muted = secondary number */
  kind?: 'name' | 'value' | 'muted';
}

export interface Props {
  question: string;
  answerTitle: string;
  columns: Column[];
  rows: string[][];
  /** ms before flipping to the back slot (only used when a back slot is given) */
  flipAt?: number;
  /** total loop length in ms */
  cycle?: number;
  align?: 'right' | 'left' | 'center';
  /** false hides the answer table (no-flip mode), e.g. to show only the `after` slot */
  showAnswer?: boolean;
  /** false hides the "Clarior" icon + title row */
  showHeader?: boolean;
  /** true lets the card fill its container (no 640px max width) */
  fullWidth?: boolean;
  /** true when the same information is given in text next to it (decorative) */
  decorative?: boolean;
  class?: string;
}

const {
  question,
  answerTitle,
  columns,
  rows,
  flipAt = 5500,
  cycle = 15000,
  align = 'right',
  showAnswer = true,
  showHeader = true,
  fullWidth = false,
  decorative = true,
  class: className = '',
} = Astro.props;

const hasBack = Astro.slots.has('back');
const hasAfter = !hasBack && Astro.slots.has('after');
const cellClass = (kind?: Column['kind']) =>
  kind === 'value' ? 'pv-val' : kind === 'muted' ? 'pv-days' : 'pv-name';
const rowDelay = (i: number) => `--d:${(2.1 + i * 0.3).toFixed(1)}s`;
---

<div
  class:list={['pv-chat', align === 'left' && 'pv-chat--left', align === 'center' && 'pv-chat--center', fullWidth && 'pv-chat--full', className]}
  data-pv-demo
  data-pv-flip={hasBack ? String(flipAt) : undefined}
  data-pv-cycle={String(cycle)}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="pv-card">
    {showHeader && (
      <div class="pv-head">
        <div class="pv-title">
          <img class="pv-gen-ai-icon" src="/uploads/clarior-icon.svg" width="25" height="23" alt="" />
          Clarior
        </div>
      </div>
    )}

    <div class="pv-rowpos pv-right pv-qrow">
      <div class="pv-bubble pv-user pv-step" style="--d:.1s">{question}</div>
    </div>

    {
      hasBack ? (
        <div class="pv-flip">
          <div class="pv-flipper">
            <div class="pv-face pv-front">
              <div class="pv-rowpos pv-left pv-slot">
                <div class="pv-typing"><span /><span /><span /></div>
                <div class="pv-answer pv-step" style="--d:1.7s">
                  <div class="pv-answer-head"><div class="pv-ans-h">{answerTitle}</div></div>
                  <table class="pv-table">
                    <thead><tr>{columns.map((c) => <th class:list={[c.kind && c.kind !== 'name' && 'pv-r']}>{c.label}</th>)}</tr></thead>
                    <tbody>
                      {rows.map((r, i) => (
                        <tr class="pv-step" style={rowDelay(i)}>{r.map((v, j) => <td class={cellClass(columns[j]?.kind)}>{v}</td>)}</tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="pv-face pv-back">
              <slot name="back" />
            </div>
          </div>
        </div>
      ) : showAnswer ? (
        <div class="pv-rowpos pv-left pv-slot">
          <div class="pv-typing"><span /><span /><span /></div>
          <div class="pv-answer pv-step" style="--d:1.7s">
            <div class="pv-answer-head"><div class="pv-ans-h">{answerTitle}</div></div>
            <table class="pv-table">
              <thead><tr>{columns.map((c) => <th class:list={[c.kind && c.kind !== 'name' && 'pv-r']}>{c.label}</th>)}</tr></thead>
              <tbody>
                {rows.map((r, i) => (
                  <tr class="pv-step" style={rowDelay(i)}>{r.map((v, j) => <td class={cellClass(columns[j]?.kind)}>{v}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <div class="pv-rowpos pv-left pv-slot pv-slot--typing">
          <div class="pv-typing"><span /><span /><span /></div>
        </div>
      )
    }
    {hasAfter && (
      <div class="pv-after">
        <slot name="after" />
      </div>
    )}
  </div>
</div>

<!-- Global on purpose: the back slot is written in the parent page, so scoped styles would not reach it. -->
<style is:global>
  .pv-chat { width: 100%; max-width: 640px; margin: 0 0 0 auto; text-align: left; }
  .pv-card { background: #ffffff; border: 1px solid rgba(15, 23, 42, 0.15); border-radius: 20px; padding: 24px; }
  .pv-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .pv-title { display: flex; align-items: center; gap: 8px; font-size: 18px; font-weight: 700; line-height: 1.25; color: #1f2937; }
  .pv-gen-ai-icon { width: 25px; height: 23px; flex: none; object-fit: contain; }

  .pv-rowpos { display: flex; }
  .pv-right { justify-content: flex-end; }
  .pv-left { justify-content: flex-start; }
  .pv-slot { position: relative; }

  .pv-bubble { max-width: 82%; font-size: 13px; line-height: 1.4; padding: 10px 14px; border-radius: 16px; }
  .pv-qrow { margin-bottom: 12px; }
  .pv-user { font-weight: 700; background: #e5e7eb; color: #1f2937; border-bottom-right-radius: 5px; }


  .pv-typing { position: absolute; left: 0; top: 0; display: flex; gap: 5px; background: #f1f5f9; padding: 12px 16px; border-radius: 16px; border-bottom-left-radius: 5px; opacity: 0; }
  .pv-typing span { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: pvDotB 1.2s ease-in-out infinite; }
  .pv-typing span:nth-child(2) { animation-delay: .15s; }
  .pv-typing span:nth-child(3) { animation-delay: .3s; }
  .pv-chat.is-play .pv-typing { animation: pvThink 1.1s ease .6s forwards; }

  .pv-answer { width: 100%; background: #f8fafc; border: 1px solid rgba(15, 23, 42, 0.06); border-radius: 16px; border-bottom-left-radius: 5px; padding: 12px 14px; }
  .pv-answer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; gap: 8px; }
  .pv-ans-h { white-space: nowrap; font-size: 11px; font-weight: 600; color: #94a3b8; }

  .pv-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .pv-table thead th { text-align: left; font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .03em; padding: 0 8px 7px 8px; border-bottom: 1px solid #e2e8f0; }
  .pv-table thead th.pv-r { text-align: right; }
  .pv-table td { padding: 8px; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
  .pv-table tbody tr:last-child td { border-bottom: 0; }
  .pv-name { color: #334155; }
  .pv-val { color: #0f172a; font-weight: 700; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pv-days { color: #64748b; text-align: right; }


  .pv-flip { perspective: 1400px; }
  .pv-flipper { display: grid; transition: transform .8s cubic-bezier(.4,.2,.2,1); transform-style: preserve-3d; }
  .pv-chat.is-flipped .pv-flipper { transform: rotateY(180deg); }
  .pv-face { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 12px; min-height: 320px; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .pv-back { transform: rotateY(180deg); justify-content: center; }

  .pv-panels { display: grid; grid-template-columns: 1fr; gap: 10px; }
  @media (min-width: 640px) { .pv-panels { grid-template-columns: 1fr 1fr; } }
  .pv-panel { background: #f8fafc; border: 1px solid rgba(15, 23, 42, 0.06); border-radius: 16px; padding: 12px 14px; }
  .pv-ai { border-color: #bfdbfe; }
  .pv-local { border-color: #bbf7d0; }
  .pv-label { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 10px; }
  .pv-label-ai { color: #2563eb; }
  .pv-label-local { color: #16a34a; }
  .pv-q { font-weight: 700; background: #eff6ff; color: #1e3a8a; border-radius: 10px; padding: 7px 10px; font-size: 12px; line-height: 1.4; margin-bottom: 10px; }
  .pv-small { font-size: 10px; color: #94a3b8; margin-bottom: 5px; }
  .pv-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; }
  .pv-chips span { font-size: 11px; background: #fff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 8px; color: #334155; }
  .pv-no { font-size: 12px; color: #64748b; margin-top: 3px; }
  .pv-no b { color: #ef4444; font-size: 10px; margin-right: 4px; }
  .pv-mini { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 12px; }
  .pv-mini div { display: flex; justify-content: space-between; gap: 8px; padding: 7px 10px; border-top: 1px solid #eef2f7; color: #334155; }
  .pv-mini div:first-child { border-top: 0; }
  .pv-mini b { color: #0f172a; font-variant-numeric: tabular-nums; }
  .pv-note { display: flex; align-items: center; gap: 6px; margin-top: 2px; font-size: 13px; font-weight: 400; color: #111827; }
  .pv-note svg { flex: none; color: #111827; }
  .pv-bstep { opacity: 0; transform: translateY(8px); }
  .pv-chat.is-flipped .pv-bstep { animation: pvIn .35s ease forwards; animation-delay: calc(var(--d, 0s) + .4s); }
  .pv-big { font-size: 13px; color: #334155; margin: 2px 0 8px; }
  .pv-big b { font-size: 28px; font-weight: 700; color: #0f172a; margin-right: 4px; }
  .pv-yes { font-size: 12px; color: #64748b; margin-top: 3px; }
  .pv-yes b { color: #16a34a; font-size: 10px; margin-right: 4px; }
  .pv-list { list-style: none; margin: 6px 0 0; padding: 0; }
  .pv-chips + .pv-small { margin-top: 10px; }
  .pv-list li { margin-top: 4px; }
  .pv-ai .pv-mini, .pv-local .pv-mini { margin-bottom: 4px; }
  .pv-chat.is-paused, .pv-chat.is-paused * { animation-play-state: paused !important; }
  .pv-step { opacity: 0; transform: translateY(8px); }
  .pv-chat.is-play .pv-step { animation: pvIn .35s ease forwards; animation-delay: var(--d, 0s); }
  @keyframes pvIn { to { opacity: 1; transform: none; } }
  @keyframes pvThink { 0% { opacity: 0; } 20%, 80% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes pvDotB { 0%, 60%, 100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) {
    .pv-step, .pv-bstep { opacity: 1; transform: none; }
    .pv-chat.is-play .pv-step, .pv-chat.is-play .pv-typing, .pv-chat.is-flipped .pv-bstep { animation: none; }
    .pv-flipper { transition: none; }
    .pv-typing span { animation: none; }
  }
  .pv-chat--left { margin: 0 auto 0 0; }
  .pv-chat--center { margin: 0 auto; }
  .pv-chat--full { max-width: none; margin: 0; }
  .pv-slot--typing { min-height: 40px; }
  .pv-slot--typing + .pv-after { margin-top: -40px; }
  .pv-after { margin-top: 12px; display: flex; flex-direction: column; gap: 10px; }

  /* Inside blog/case-study articles: undo the article's own table/paragraph styles
     (ArticleBody .blog-article) so the card looks the same as on the Clarior page. */
  .blog-article .pv-chat { font-size: 16px; line-height: 1.5; letter-spacing: normal; }
  .blog-article .pv-chat p { margin: 0; }
  .blog-article .pv-chat img { margin: 0; border-radius: 0; box-shadow: none; }
  .blog-article .pv-chat ul { margin: 6px 0 0; padding: 0; list-style: none; }
  .blog-article .pv-chat li { margin: 4px 0 0; padding: 0; }
  .blog-article .pv-chat li::before { content: none; display: none; }
  .blog-article .pv-chat .pv-table { display: table; width: 100%; border-collapse: collapse; border-spacing: 0; margin: 0; font-size: 12px; border: 0; border-radius: 0; overflow: visible; background: transparent; white-space: normal; }
  .blog-article .pv-chat .pv-table thead { background: none; }
  .blog-article .pv-chat .pv-table thead th { padding: 0 8px 7px 8px; font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .03em; line-height: 1.5; border-bottom: 1px solid #e2e8f0; }
  .blog-article .pv-chat .pv-table tbody td { padding: 8px; border-bottom: 1px solid #eef2f7; vertical-align: middle; line-height: 1.5; color: inherit; }
  .blog-article .pv-chat .pv-table tbody tr:last-child td { border-bottom: 0; }
  .blog-article .pv-chat .pv-table tbody tr:nth-child(even) { background: none; }
  .blog-article .pv-chat .pv-table tbody td.pv-name { font-weight: 400; color: #334155; }
  .blog-article .pv-chat .pv-table tbody td.pv-val { font-weight: 700; color: #0f172a; }
  .blog-article .pv-chat .pv-table tbody td.pv-days { color: #64748b; }
</style>

<script>
  // Plays the chat, optionally flips to the back side, and repeats while on screen.
  function initPrivacyDemo() {
    document.querySelectorAll<HTMLElement>('[data-pv-demo]').forEach(bindPrivacyDemo);
  }
  function bindPrivacyDemo(demo: HTMLElement) {
    if (demo.dataset.pvBound) return;
    demo.dataset.pvBound = '1';
    // Each demo has its own timing (data-pv-flip / data-pv-cycle, in ms) so they don't flip together.
    const hasFlip = demo.dataset.pvFlip !== undefined;
    const FLIP_AT = Number(demo.dataset.pvFlip) || 5500;
    const CYCLE = hasFlip
      ? Math.max(Number(demo.dataset.pvCycle) || 15000, FLIP_AT + 4000)
      : Math.max(Number(demo.dataset.pvCycle) || 9000, 6000);

    // One pending step at a time, so it can be paused on hover and resumed with the time left.
    let timer: ReturnType<typeof setTimeout> | undefined;
    let action: (() => void) | undefined;
    let dueAt = 0;
    let remaining = 0;
    let visible = false;
    let hovered = false;

    const schedule = (fn: () => void, ms: number) => {
      clearTimeout(timer);
      action = fn; dueAt = Date.now() + ms; remaining = ms;
      if (visible && !hovered) timer = setTimeout(fn, ms);
    };
    const flip = () => { demo.classList.add('is-flipped'); schedule(cycle, CYCLE - FLIP_AT); };
    function cycle() {
      demo.classList.remove('is-play', 'is-flipped');
      void demo.offsetWidth;
      demo.classList.add('is-play');
      if (hasFlip) schedule(flip, FLIP_AT);
      else schedule(cycle, CYCLE);
    }
    const pause = () => {
      if (timer === undefined) return;
      clearTimeout(timer); timer = undefined;
      remaining = Math.max(0, dueAt - Date.now());
    };
    const resume = () => {
      if (!visible || hovered || !action) return;
      dueAt = Date.now() + remaining;
      timer = setTimeout(action, remaining);
    };

    demo.addEventListener('mouseenter', () => { hovered = true; demo.classList.add('is-paused'); pause(); });
    demo.addEventListener('mouseleave', () => { hovered = false; demo.classList.remove('is-paused'); resume(); });

    if (!('IntersectionObserver' in window)) { visible = true; cycle(); return; }
    new IntersectionObserver((entries) => {
      const now = entries.some((e) => e.isIntersecting);
      if (now === visible) return;
      visible = now;
      clearTimeout(timer); timer = undefined;
      if (visible) cycle();
    }, { threshold: 0.35 }).observe(demo);
  }
  document.addEventListener('astro:page-load', initPrivacyDemo);
</script>
