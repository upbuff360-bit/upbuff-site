---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

export interface TestimonialItem {
  /** Company / source name shown above the quote */
  company?: string;
  /** Company logo: inline HTML/SVG string or public path used in <img> */
  logo?: string;
  quote: string;
  name?: string;
  role?: string;
  /** Profile picture of the person: inline HTML/SVG string or public path used in <img> */
  avatar?: string;
  /** Set true to make the card span 2 columns (wide card) */
  wide?: boolean;
  /** Optional URL to the full case study — when set, a "Read full case study" link is shown */
  caseStudyUrl?: string;
}

export interface StatCard {
  /** Large number/text e.g. "10,000+" */
  stat: string;
  label?: string;
  /** Optional watercolor / gradient background HTML string */
  backgroundImage?: string;
  /** Inline CSS gradient fallback, e.g. 'linear-gradient(135deg,#f97316,#ec4899)' */
  gradient?: string;
}

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  /** Row 1 items. The stat card replaces the last slot automatically if provided */
  row1?: Array<TestimonialItem>;
  /** Row 2 items */
  row2?: Array<TestimonialItem>;
  /** Optional stat/highlight card — appears as the 3rd column in row 1 */
  statCard?: StatCard;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  row1 = [],
  row2 = [],
  statCard,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-5xl mx-auto ${(classes as Record<string, string>)?.container ?? ''}`}
  bg={bg}
>

  <!-- ── Centered heading ───────────────────────────────────── -->
  {(title || subtitle) && (
    <div class="text-center mb-10 md:mb-12 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
      {title && (
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight tracking-tight font-heading text-heading dark:text-gray-100 mb-3"
          set:html={title}
        />
      )}
      {subtitle && (
        <p class="text-muted text-base md:text-lg dark:text-slate-400 max-w-5xl mx-auto" set:html={subtitle} />
      )}
    </div>
  )}

  <!-- ── Row 1: up to 2 testimonials + optional stat card ───── -->
  {row1.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
      {row1.map(({ company, logo, quote, name, role, avatar, wide, caseStudyUrl }, i) => (
        <div
          class:list={[
            'rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6 flex flex-col justify-between shadow-sm',
            wide ? 'sm:col-span-2 lg:col-span-1' : '',
            'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
          ]}
          style={`animation-delay: ${i * 80}ms`}
        >
          <!-- Logo / company name -->
          <div class="mb-4">
            {logo
              ? logo.startsWith('<')
                ? <div class="testimonial-logo h-10 flex items-center text-black"><Fragment set:html={logo} /></div>
                : <img src={logo} alt={company ?? ''} class="testimonial-logo h-7 w-auto max-w-full object-contain grayscale contrast-200 brightness-75" loading="lazy" />
              : company && (
                <span class="text-sm font-medium text-gray-400 dark:text-gray-500">{company}</span>
              )
            }
          </div>

          <!-- Quote -->
          <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-1 mb-3" set:html={`"${quote}"`} />

          <!-- Optional "Read full case study" link -->
          {caseStudyUrl && (
            <a
              href={caseStudyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-semibold text-[#22C55E] hover:text-[#16a34a] mb-5 group/link"
            >
              Read full case study
              <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          )}

          <!-- Attribution -->
          {(name || role || avatar) && (
            <div class="flex items-center">
              {avatar && (
                <div class="h-10 w-10 rounded-full border border-slate-200 dark:border-slate-600 overflow-hidden flex-shrink-0 bg-gray-100 dark:bg-slate-800">
                  {avatar.startsWith('<')
                    ? <Fragment set:html={avatar} />
                    : <img src={avatar} alt={name ?? ''} class="h-10 w-10 object-cover" loading="lazy" />
                  }
                </div>
              )}
              <div class={avatar ? 'ml-3 rtl:ml-0 rtl:mr-3' : ''}>
                {name && <p class="text-sm font-bold text-heading dark:text-gray-100">{name}</p>}
                {role && <p class="text-xs text-muted dark:text-slate-400">{role}</p>}
              </div>
            </div>
          )}
        </div>
      ))}

      <!-- Stat card (3rd slot in row 1) -->
      {statCard && (
        <div
          class="rounded-2xl overflow-hidden shadow-sm relative flex flex-col justify-end intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          style={`animation-delay: ${row1.length * 80}ms`}
        >
          <!-- Background -->
          <div class="absolute inset-0">
            {statCard.backgroundImage
              ? <Fragment set:html={statCard.backgroundImage} />
              : <div class="w-full h-full" style={statCard.gradient ? `background: ${statCard.gradient}` : 'background: linear-gradient(135deg, #f97316, #ec4899)'} />
            }
          </div>
          <!-- Stat text (bottom-left overlay on white bg) -->
          <div class="relative bg-white dark:bg-slate-900 m-0 p-6">
            <p class="text-4xl font-bold text-heading dark:text-gray-100 leading-none mb-1" set:html={statCard.stat} />
            {statCard.label && (
              <p class="text-sm text-muted dark:text-slate-400 leading-snug" set:html={statCard.label} />
            )}
          </div>
        </div>
      )}
    </div>
  )}

  <!-- ── Row 2: full-width 2-col testimonials ─────────────── -->
  {row2.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {row2.map(({ company, logo, quote, name, role, avatar, caseStudyUrl }, i) => (
        <div
          class:list={[
            'rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6 flex flex-col justify-between shadow-sm',
            'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
          ]}
          style={`animation-delay: ${i * 80}ms`}
        >
          <div class="mb-4">
            {logo
              ? logo.startsWith('<')
                ? <div class="testimonial-logo h-10 flex items-center text-black"><Fragment set:html={logo} /></div>
                : <img src={logo} alt={company ?? ''} class="testimonial-logo h-7 w-auto max-w-full object-contain grayscale contrast-200 brightness-75" loading="lazy" />
              : company && (
                <span class="text-sm font-medium text-gray-400 dark:text-gray-500">{company}</span>
              )
            }
          </div>
          <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-1 mb-3" set:html={`"${quote}"`} />

          {caseStudyUrl && (
            <a
              href={caseStudyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-semibold text-[#22C55E] hover:text-[#16a34a] mb-5 group/link"
            >
              Read full case study
              <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          )}

          {(name || role || avatar) && (
            <div class="flex items-center">
              {avatar && (
                <div class="h-10 w-10 rounded-full border border-slate-200 dark:border-slate-600 overflow-hidden flex-shrink-0 bg-gray-100 dark:bg-slate-800">
                  {avatar.startsWith('<')
                    ? <Fragment set:html={avatar} />
                    : <img src={avatar} alt={name ?? ''} class="h-10 w-10 object-cover" loading="lazy" />
                  }
                </div>
              )}
              <div class={avatar ? 'ml-3 rtl:ml-0 rtl:mr-3' : ''}>
                {name && <p class="text-sm font-bold text-heading dark:text-gray-100">{name}</p>}
                {role && <p class="text-xs text-muted dark:text-slate-400">{role}</p>}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  )}

</WidgetWrapper>

<style>
  .testimonial-logo :global(svg) {
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  .testimonial-logo :global(svg *) {
    fill: currentColor !important;
    stroke: currentColor !important;
  }
</style>